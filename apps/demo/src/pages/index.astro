---
import { CANDLE_DATA } from "../lib/candles";
import "../styles/global.css";

const timeframes = ["1m", "5m", "15m", "1h", "4h", "1d"];
const defaultTf = "1h";

const candleData = JSON.stringify(CANDLE_DATA);
const lastCandle = CANDLE_DATA[defaultTf].at(-1)!;
const lastCandleJson = JSON.stringify(lastCandle);
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LoomChart — Rust/WASM Trading Charts</title>
    <meta name="description" content="LoomChart — High-performance real-time trading charts powered by Rust &amp; WebAssembly. 60fps rendering, no backend required." />
    <meta property="og:title" content="LoomChart — Rust/WASM Trading Charts" />
    <meta property="og:description" content="60fps candlestick charts running entirely in the browser via WebAssembly. No backend needed." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%230d1117'/><rect x='5' y='18' width='4' height='9' rx='1' fill='%23f85149'/><rect x='6.5' y='14' width='1' height='5' rx='0.5' fill='%23f85149'/><rect x='6.5' y='26' width='1' height='3' rx='0.5' fill='%23f85149'/><rect x='13' y='12' width='4' height='10' rx='1' fill='%233fb950'/><rect x='14.5' y='8' width='1' height='5' rx='0.5' fill='%233fb950'/><rect x='14.5' y='21' width='1' height='4' rx='0.5' fill='%233fb950'/><rect x='21' y='8' width='4' height='12' rx='1' fill='%233fb950'/><rect x='22.5' y='4' width='1' height='5' rx='0.5' fill='%233fb950'/><rect x='22.5' y='19' width='1' height='5' rx='0.5' fill='%233fb950'/></svg>" />

    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { height: 100%; font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, monospace; overflow: hidden; }
      body { background: var(--bg); color: var(--fg); }

      body.dark  { --bg:#0d1117; --bg2:#161b22; --bg3:#1c2128; --border:#30363d; --fg:#e6edf3; --muted:#8b949e; --dim:#484f58; --accent:#58a6ff; --up:#3fb950; --dn:#f85149; --badge:#30363d; }
      body.light { --bg:#ffffff; --bg2:#f6f8fa; --bg3:#eaeef2; --border:#d0d7de; --fg:#1f2328; --muted:#656d76; --dim:#9ea7b3; --accent:#0969da; --up:#1a7f37; --dn:#cf222e; --badge:#eaeef2; }

      /* Button base styles */
      .btn { display:inline-flex; align-items:center; border:none; cursor:pointer; transition:background 0.12s, color 0.12s; font-family:inherit; }
      .btn-ghost { background:transparent; color:var(--muted); border-radius:4px; }
      .btn-ghost:hover { background:var(--border); color:var(--fg); }
      .btn-ghost.active { background:var(--accent); color:#fff; }
      .btn-ghost.active-up { background:rgba(63,185,80,0.15); color:var(--up); }
      .btn-ghost.warn:hover { background:rgba(248,81,73,0.15); color:var(--dn); }

      .tf-btn { font-size:11px; font-weight:500; padding:2px 7px; border-radius:3px; }
      .ct-btn { font-size:11px; font-weight:500; padding:3px 9px; border-radius:3px; }
      .scale-btn { font-size:11px; font-weight:600; padding:3px 9px; border-radius:3px; font-family:inherit; }
      .icon-btn { font-size:12px; padding:3px 8px; border-radius:4px; }

      .tool-btn {
        width:34px; height:34px; align-items:center; justify-content:center;
        border-radius:5px; cursor:pointer; color:var(--muted);
        border:none; background:transparent; display:flex;
      }
      .tool-btn:hover { background:var(--border); color:var(--fg); }
      .tool-btn.active { background:var(--accent); color:#fff; }
      .tool-btn.warn:hover { background:rgba(248,81,73,0.15); color:var(--dn); }
      .tool-sep { width:20px; height:1px; background:var(--border); margin:3px auto; }

      .sep { width:1px; height:18px; background:var(--border); margin:0 4px; flex-shrink:0; }

      .ohlcv-up { color:var(--up); }
      .ohlcv-down { color:var(--dn); }

      .pulse { animation:pulse 2s ease-in-out infinite; }
      @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

      /* Log scale overlay badge on chart */
      #log-badge {
        position:absolute; top:8px; left:8px; z-index:5;
        font-size:10px; font-weight:700; letter-spacing:0.05em;
        background:rgba(88,166,255,0.2); color:var(--accent);
        border:1px solid rgba(88,166,255,0.3);
        padding:2px 6px; border-radius:3px;
        pointer-events:none;
      }
      #draw-hint {
        position:absolute; bottom:8px; left:50%; transform:translateX(-50%); z-index:5;
        font-size:11px; background:rgba(0,0,0,0.7); color:#fff;
        padding:4px 12px; border-radius:12px; pointer-events:none;
        white-space:nowrap;
      }

      /* Layouts dropdown */
      .popover {
        position:absolute; top:42px; right:8px; z-index:50;
        background:var(--bg2); border:1px solid var(--border); border-radius:6px;
        padding:10px; min-width:260px;
        box-shadow:0 8px 24px rgba(0,0,0,0.4);
      }
      .popover h4 { font-size:11px; color:var(--muted); margin-bottom:6px; font-weight:600; letter-spacing:0.05em; text-transform:uppercase; }
      .popover-row { display:flex; gap:6px; align-items:center; padding:4px 0; }
      .popover-row + .popover-row { border-top:1px solid var(--border); }
      .popover-input { flex:1; background:var(--bg); border:1px solid var(--border); color:var(--fg); padding:4px 8px; border-radius:3px; font-family:inherit; font-size:11px; outline:none; }
      .popover-input:focus { border-color:var(--accent); }
      .layout-item { flex:1; font-size:11px; color:var(--fg); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
      .layout-item small { color:var(--muted); margin-left:4px; }

      /* Bottom toolbar (replay/playback) */
      .playback-bar {
        display:flex; align-items:center; gap:8px;
        padding:0 12px; height:36px; flex-shrink:0;
        border-top:1px solid var(--border);
        background:var(--bg2); user-select:none;
      }
      .seg-btn { font-size:11px; padding:3px 10px; border-radius:3px; border:none; background:transparent; color:var(--muted); cursor:pointer; font-family:inherit; transition:background 0.1s, color 0.1s; }
      .seg-btn:hover { color:var(--fg); background:var(--bg3); }
      .seg-btn.active { background:var(--accent); color:#fff; }
      .seg-group { display:flex; gap:1px; padding:1px; border-radius:4px; background:var(--bg3); }
      .scrubber { flex:1; -webkit-appearance:none; appearance:none; height:4px; background:var(--bg3); border-radius:2px; outline:none; cursor:pointer; }
      .scrubber::-webkit-slider-thumb { -webkit-appearance:none; appearance:none; width:14px; height:14px; border-radius:50%; background:var(--accent); cursor:pointer; }
      .scrubber::-moz-range-thumb { width:14px; height:14px; border-radius:50%; background:var(--accent); cursor:pointer; border:none; }
      .speed-select { background:var(--bg); border:1px solid var(--border); color:var(--fg); padding:2px 6px; border-radius:3px; font-family:inherit; font-size:11px; outline:none; cursor:pointer; }

      /* Alerts panel */
      #alerts-panel {
        position:absolute; top:8px; right:8px; z-index:5;
        background:var(--bg2); border:1px solid var(--border); border-radius:6px;
        padding:8px 10px; min-width:180px; max-width:280px;
        font-size:11px;
      }
      #alerts-panel h4 { font-size:10px; color:var(--muted); margin-bottom:4px; font-weight:600; letter-spacing:0.05em; text-transform:uppercase; }
      .alert-item { display:flex; align-items:center; gap:6px; padding:3px 0; }
      .alert-item + .alert-item { border-top:1px solid var(--border); }
      .alert-dot { width:6px; height:6px; border-radius:50%; flex-shrink:0; }
      .alert-dot.armed { background:var(--accent); }
      .alert-dot.triggered { background:var(--up); animation:flash 1s ease-in-out infinite; }
      @keyframes flash { 0%,100%{opacity:1} 50%{opacity:0.3} }
      .alert-price { flex:1; tabular-nums:tabular-nums; color:var(--fg); }
      .alert-del { background:transparent; border:none; color:var(--muted); cursor:pointer; padding:0 4px; font-size:13px; }
      .alert-del:hover { color:var(--dn); }
      .alert-flash {
        position:absolute; inset:0; pointer-events:none; z-index:6;
        background:radial-gradient(circle at center, rgba(63,185,80,0.25) 0%, transparent 60%);
        animation:alertflash 800ms ease-out forwards;
      }
      @keyframes alertflash { 0%{opacity:1} 100%{opacity:0} }
    </style>
  </head>

  <body class="dark h-full flex flex-col" x-data="demoApp()" x-init="init()">

    <!-- ── Row 1: Header (brand / symbol / timeframes / global) ── -->
    <header class="flex items-center gap-2 px-3 shrink-0 border-b select-none"
            style="height:42px;border-color:var(--border);background:var(--bg2)">

      <!-- Brand -->
      <span class="font-semibold text-sm" style="color:var(--accent);letter-spacing:.04em">LoomChart</span>
      <div class="sep"></div>

      <!-- Symbol + live price -->
      <span class="text-sm font-medium" style="color:var(--fg)">BTC / USD</span>
      <span class="text-sm font-semibold tabular-nums"
            x-show="lastPrice !== null"
            x-text="fmt(lastPrice)"
            x-bind:class="priceDir === 'up' ? 'ohlcv-up' : priceDir === 'dn' ? 'ohlcv-down' : ''"
            style="min-width:80px"></span>
      <div class="sep"></div>

      <!-- Timeframe buttons -->
      <div class="flex gap-0.5">
        {timeframes.map((tf) => (
          <button
            class={`btn btn-ghost tf-btn ${tf === defaultTf ? "active" : ""}`}
            x-on:click={`switchTimeframe('${tf}')`}
            x-bind:class={`activeTf === '${tf}' ? 'active' : ''`}
          >{tf}</button>
        ))}
      </div>

      <div class="flex-1"></div>

      <!-- Mode status pill (small, shows current mode) -->
      <div class="flex items-center gap-1.5 px-2 py-0.5 rounded text-xs"
           style="background:var(--bg3);color:var(--muted)">
        <span class="w-1.5 h-1.5 rounded-full inline-block"
              x-bind:class="mode === 'simulate' || mode === 'replay' ? 'pulse' : ''"
              x-bind:style="mode === 'simulate' ? 'background:var(--up)' : mode === 'replay' ? 'background:var(--accent)' : 'background:var(--muted)'"></span>
        <span x-text="mode === 'simulate' ? 'Simulating' : mode === 'replay' ? 'Replay ' + replayPos + '/' + replayTotal : 'Static'"></span>
      </div>

      <!-- Layouts button -->
      <button class="btn btn-ghost icon-btn"
              x-on:click="layoutsOpen = !layoutsOpen"
              x-bind:class="layoutsOpen ? 'active' : ''"
              title="Save / load chart layouts">💾</button>

      <!-- Badges -->
      <span class="text-[10px] px-2 py-0.5 rounded-full" style="background:var(--badge);color:var(--muted)">synthetic</span>
      <span class="text-[10px] px-2 py-0.5 rounded-full border" style="background:#3d1f00;color:#e3b341;border-color:rgba(227,179,65,0.3)">alpha</span>

      <!-- Theme toggle -->
      <button class="btn btn-ghost icon-btn"
              x-on:click="toggleTheme()"
              x-text="darkMode ? '☀' : '🌙'"
              title="Toggle theme"></button>

      <!-- GitHub -->
      <a href="https://github.com/casoon/loomchart" target="_blank" rel="noopener"
         class="btn btn-ghost icon-btn" title="GitHub">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      </a>
    </header>

    <!-- Layouts popover -->
    <div class="popover" x-show="layoutsOpen" x-cloak x-on:click.outside="layoutsOpen = false">
      <h4>Save current layout</h4>
      <div class="popover-row" style="border:none">
        <input class="popover-input" type="text" placeholder="My layout"
               x-model="layoutNameInput"
               x-on:keydown.enter="saveLayout()">
        <button class="btn btn-ghost scale-btn" x-on:click="saveLayout()">Save</button>
      </div>
      <h4 style="margin-top:8px">Saved layouts</h4>
      <template x-if="savedLayouts.length === 0">
        <div style="font-size:11px;color:var(--dim);padding:4px 0">No layouts saved yet.</div>
      </template>
      <template x-for="(lo, idx) in savedLayouts" x-bind:key="lo.ts">
        <div class="popover-row">
          <span class="layout-item">
            <span x-text="lo.name"></span>
            <small x-text="lo.tf + ' · ' + lo.chartType"></small>
          </span>
          <button class="btn btn-ghost scale-btn" x-on:click="loadLayout(idx)">Load</button>
          <button class="alert-del" x-on:click="deleteLayout(idx)" title="Delete">×</button>
        </div>
      </template>
    </div>

    <!-- ── Row 2: Toolbar (chart controls / OHLCV) ───────────── -->
    <div class="flex items-center gap-1 px-2 shrink-0 border-b select-none"
         style="height:34px;border-color:var(--border);background:var(--bg2)">

      <!-- Chart type -->
      <div class="flex gap-0.5">
        {[
          { id: "candlestick", label: "Candles" },
          { id: "ohlc",        label: "OHLC" },
          { id: "hollow",      label: "Hollow" },
          { id: "ha",          label: "Heikin Ashi" },
          { id: "line",        label: "Line" },
          { id: "area",        label: "Area" },
          { id: "renko",       label: "Renko" },
        ].map(({ id, label }) => (
          <button
            class="btn btn-ghost ct-btn"
            x-on:click={`setChartType('${id}')`}
            x-bind:class={`chartType === '${id}' ? 'active' : ''`}
          >{label}</button>
        ))}
      </div>

      <div class="sep"></div>

      <!-- Fit to data -->
      <button class="btn btn-ghost scale-btn flex items-center gap-1"
              x-on:click="fitToData()"
              title="Fit all data to view (F)">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M1 4V1h3M8 1h3v3M11 8v3H8M4 11H1V8"/>
        </svg>
        Fit
      </button>

      <!-- Log scale toggle — very visible when active -->
      <button class="btn btn-ghost scale-btn"
              x-on:click="toggleLogScale()"
              x-bind:class="logScale ? 'active' : ''"
              title="Toggle logarithmic price scale (L)">
        <span x-text="logScale ? 'LOG ✓' : 'LOG'"></span>
      </button>

      <!-- Axis lock toggle — prevents fit/zoom from changing price range -->
      <button class="btn btn-ghost scale-btn flex items-center gap-1"
              x-on:click="toggleAxisLock()"
              x-bind:class="axisLocked ? 'active' : ''"
              title="Lock price axis (A) — prevents auto-fit from changing price range">
        <span x-text="axisLocked ? '🔒' : '🔓'"></span>
        <span>Axis</span>
      </button>

      <!-- Volume profile (VPVR) toggle -->
      <button class="btn btn-ghost scale-btn flex items-center gap-1"
              x-on:click="toggleVolumeProfile()"
              x-bind:class="showVolumeProfile ? 'active' : ''"
              title="Volume Profile Visible Range (V) — shows volume distribution by price">
        <svg width="11" height="11" viewBox="0 0 11 11" fill="currentColor">
          <rect x="0" y="1" width="3"  height="1.4"/>
          <rect x="0" y="3" width="7"  height="1.4"/>
          <rect x="0" y="5" width="10" height="1.4"/>
          <rect x="0" y="7" width="5"  height="1.4"/>
          <rect x="0" y="9" width="2"  height="1.4"/>
        </svg>
        <span>VP</span>
      </button>

      <div class="sep"></div>

      <!-- OHLCV crosshair info -->
      <div class="flex items-center gap-2 text-[11px] tabular-nums" x-show="ohlcv.open !== null" style="color:var(--muted)">
        <span>O <span x-bind:class="ohlcv.dir" x-text="fmt(ohlcv.open)"></span></span>
        <span>H <span x-bind:class="ohlcv.dir" x-text="fmt(ohlcv.high)"></span></span>
        <span>L <span x-bind:class="ohlcv.dir" x-text="fmt(ohlcv.low)"></span></span>
        <span>C <b x-bind:class="ohlcv.dir" x-text="fmt(ohlcv.close)"></b></span>
        <span>V <span x-text="fmtVol(ohlcv.volume)"></span></span>
      </div>

      <div class="flex-1"></div>

      <!-- Keyboard hint -->
      <span class="text-[10px]" style="color:var(--dim)">
        <kbd class="px-1 rounded" style="background:var(--bg3)">F</kbd> fit &nbsp;
        <kbd class="px-1 rounded" style="background:var(--bg3)">L</kbd> log &nbsp;
        <kbd class="px-1 rounded" style="background:var(--bg3)">A</kbd> lock &nbsp;
        <kbd class="px-1 rounded" style="background:var(--bg3)">V</kbd> vp &nbsp;
        <kbd class="px-1 rounded" style="background:var(--bg3)">Esc</kbd> cancel
      </span>
    </div>

    <!-- ── Chart area + left drawing toolbar ─────────────────── -->
    <div class="flex flex-1 overflow-hidden">

      <!-- Left drawing toolbar -->
      <div class="flex flex-col items-center gap-1 py-2 shrink-0 border-r"
           style="width:40px;background:var(--bg2);border-color:var(--border)">

        <button class="tool-btn" title="Pointer — select &amp; pan (Esc)"
                x-on:click="setDrawTool('pointer')"
                x-bind:class="drawTool === 'pointer' ? 'active' : ''">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor"><path d="M2 1l10 6-5 1-2 5z"/></svg>
        </button>

        <div class="tool-sep"></div>

        <button class="tool-btn" title="Horizontal line — click to place"
                x-on:click="setDrawTool('hline')"
                x-bind:class="drawTool === 'hline' ? 'active' : ''">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="1" y1="8" x2="15" y2="8"/>
            <circle cx="8" cy="8" r="1.5" fill="currentColor" stroke="none"/>
          </svg>
        </button>

        <button class="tool-btn" title="Vertical line — click to place"
                x-on:click="setDrawTool('vline')"
                x-bind:class="drawTool === 'vline' ? 'active' : ''">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="8" y1="1" x2="8" y2="15"/>
            <circle cx="8" cy="8" r="1.5" fill="currentColor" stroke="none"/>
          </svg>
        </button>

        <button class="tool-btn" title="Trend line — click start, then end"
                x-on:click="setDrawTool('trendline')"
                x-bind:class="drawTool === 'trendline' ? 'active' : ''">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="2" y1="13" x2="14" y2="3"/>
            <circle cx="2" cy="13" r="1.5" fill="currentColor" stroke="none"/>
            <circle cx="14" cy="3" r="1.5" fill="currentColor" stroke="none"/>
          </svg>
        </button>

        <div class="tool-sep"></div>

        <button class="tool-btn" title="Price alert — click chart at desired level"
                x-on:click="setDrawTool('alert')"
                x-bind:class="drawTool === 'alert' ? 'active' : ''">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M7 1c2 0 4 1.5 4 4v3l1.5 2H2.5L4 8V5c0-2.5 2-4 3-4z"/>
            <path d="M5.5 11.5c0 .8.7 1.5 1.5 1.5s1.5-.7 1.5-1.5"/>
          </svg>
        </button>

        <div class="tool-sep"></div>

        <button class="tool-btn warn" title="Clear all drawings"
                x-on:click="clearTools()">
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="1.5" y1="1.5" x2="11.5" y2="11.5"/>
            <line x1="11.5" y1="1.5" x2="1.5" y2="11.5"/>
          </svg>
        </button>
      </div>

      <!-- Chart container -->
      <div id="chart-container" class="relative overflow-hidden" style="flex:1">

        <!-- Loading overlay -->
        <div x-show="loading"
             x-transition:leave="transition-opacity duration-300"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-3"
             style="background:var(--bg)">
          <svg class="animate-spin w-8 h-8" style="color:var(--accent)" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
          </svg>
          <span class="text-sm" style="color:var(--muted)">Loading chart engine…</span>
          <span class="text-xs" style="color:var(--dim)">Rust · WebAssembly · No backend</span>
        </div>

        <!-- Log scale badge (visible on chart when active) -->
        <div id="log-badge" x-show="logScale && !loading">LOG</div>

        <!-- Drawing hint overlay -->
        <div id="draw-hint" x-show="drawTool !== 'pointer' && !loading">
          <span x-text="drawHintText()"></span>
        </div>

        <!-- Alerts panel -->
        <div id="alerts-panel" x-show="alerts.length > 0 && !loading">
          <h4>Price alerts</h4>
          <template x-for="(a, idx) in alerts" x-bind:key="a.id">
            <div class="alert-item">
              <span class="alert-dot" x-bind:class="a.triggered ? 'triggered' : 'armed'"></span>
              <span x-text="(a.dir === 'above' ? '↑' : '↓')" x-bind:style="a.dir === 'above' ? 'color:var(--up)' : 'color:var(--dn)'"></span>
              <span class="alert-price" x-text="fmt(a.price)"></span>
              <button class="alert-del" x-on:click="removeAlert(idx)" title="Remove">×</button>
            </div>
          </template>
        </div>

        <!-- Alert flash overlay (visible briefly when triggered) -->
        <div class="alert-flash" x-show="alertFlash" x-cloak></div>
      </div>
    </div>

    <!-- ── Playback bar (Mode / Replay controls) ─────────────── -->
    <div class="playback-bar">
      <span class="text-[10px]" style="color:var(--muted)">MODE</span>
      <div class="seg-group">
        <button class="seg-btn" x-on:click="setMode('off')"      x-bind:class="mode === 'off'      ? 'active' : ''">Static</button>
        <button class="seg-btn" x-on:click="setMode('simulate')" x-bind:class="mode === 'simulate' ? 'active' : ''">Simulate</button>
        <button class="seg-btn" x-on:click="setMode('replay')"   x-bind:class="mode === 'replay'   ? 'active' : ''">Replay</button>
      </div>

      <!-- Replay-specific controls -->
      <template x-if="mode === 'replay'">
        <div class="flex items-center gap-2" style="flex:1">
          <button class="seg-btn" x-on:click="replayToggle()"
                  x-bind:title="replayPlaying ? 'Pause' : 'Play'">
            <span x-text="replayPlaying ? '⏸' : '▶'"></span>
          </button>
          <button class="seg-btn" x-on:click="replayStep()" title="Step forward">⏭</button>
          <input class="scrubber" type="range" min="0"
                 x-bind:max="replayTotal" x-model.number="replayPos"
                 x-on:input="replaySeek(replayPos)">
          <span class="text-[11px] tabular-nums" style="color:var(--muted);min-width:90px;text-align:right"
                x-text="replayPos + ' / ' + replayTotal"></span>
          <select class="speed-select" x-model.number="replaySpeed" x-on:change="replayRestart()">
            <option value="0.5">0.5×</option>
            <option value="1">1×</option>
            <option value="2">2×</option>
            <option value="5">5×</option>
            <option value="10">10×</option>
          </select>
        </div>
      </template>

      <!-- Simulate-specific status -->
      <template x-if="mode === 'simulate'">
        <div class="text-[11px]" style="color:var(--muted)">
          Generating synthetic candles every 1.5s · seed-deterministic
        </div>
      </template>

      <!-- Static mode hint -->
      <template x-if="mode === 'off'">
        <div class="text-[11px]" style="color:var(--dim)">
          Static historical data · switch to Simulate or Replay to animate
        </div>
      </template>
    </div>

    <!-- ── Footer ────────────────────────────────────────────── -->
    <footer class="flex items-center justify-between px-3 shrink-0 border-t text-[10px] select-none"
            style="height:26px;border-color:var(--border);background:var(--bg2);color:var(--dim)">
      <span>Scroll to zoom · Drag to pan · Double-click to fit</span>
      <span class="flex items-center gap-2">
        <span>Drawing · Alerts · Replay · Layouts · Volume Profile · 7 chart types · Log · Axis lock</span>
        <span style="color:var(--border)">·</span>
        <span style="color:var(--accent)">Rust + WebAssembly</span>
      </span>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js" defer></script>

    <script define:vars={{ candleData, defaultTf, lastCandleJson }}>
      const ALL_CANDLES = JSON.parse(candleData);
      const SEED_CANDLE = JSON.parse(lastCandleJson);
      const TF_SECONDS = { "1m":60, "5m":300, "15m":900, "1h":3600, "4h":14400, "1d":86400 };

      function toHeikinAshi(candles) {
        const out = [];
        for (let i = 0; i < candles.length; i++) {
          const c = candles[i];
          const hc = (c.o + c.h + c.l + c.c) / 4;
          const ho = i === 0 ? (c.o + c.c) / 2 : (out[i-1].o + out[i-1].c) / 2;
          out.push({ time:c.time, o:ho, h:Math.max(c.h,ho,hc), l:Math.min(c.l,ho,hc), c:hc, v:c.v });
        }
        return out;
      }

      // Renko transform — fixed brick size (1% of starting price)
      function toRenko(candles) {
        if (candles.length === 0) return [];
        const startPrice = candles[0].c;
        const brick = startPrice * 0.01;
        const bricks = [];
        let last = startPrice;
        let tOffset = 0;
        for (const c of candles) {
          while (c.c >= last + brick) {
            const open = last;
            const close = last + brick;
            bricks.push({ time: c.time + tOffset, o: open, h: close, l: open, c: close, v: 0 });
            last = close;
            tOffset += 1;
          }
          while (c.c <= last - brick) {
            const open = last;
            const close = last - brick;
            bricks.push({ time: c.time + tOffset, o: open, h: open, l: close, c: close, v: 0 });
            last = close;
            tOffset += 1;
          }
        }
        return bricks;
      }

      let simSeed = 99999;
      function simRand() {
        simSeed = (Math.imul(1664525, simSeed) + 1013904223) | 0;
        return (simSeed >>> 0) / 0x100000000;
      }

      // ── Thin WASM chart wrapper ──────────────────────────────
      class DemoChart {
        constructor(container) {
          this.container = container;
          this.chart = null;
          this._mod = null;
          this.rafId = null;
          this.onCrosshair = null;
          this._touchDist = null;
          this._toolCount = 0;
          this.drawingMode = null;
          this._trendStart = null;
          this.onDrawingPlaced = null;
        }

        async init(timeframe) {
          const mod = await import("/wasm/trading_ui.js");
          await mod.default();
          this._mod = mod;
          this._createChart(timeframe);
        }

        _createChart(timeframe) {
          if (this.chart) { try { this.chart.free?.(); } catch(_){} }
          if (this.rafId) cancelAnimationFrame(this.rafId);
          if (this.canvas) this.canvas.remove();

          // Use actual container size
          const w = this.container.clientWidth  || 800;
          const h = this.container.clientHeight || 500;
          this.chart = new this._mod.WasmChart(w, h, timeframe);

          this.canvas = document.createElement("canvas");
          this.canvas.style.cssText = "position:absolute;top:0;left:0;width:100%;height:100%;cursor:crosshair;";
          this.container.appendChild(this.canvas);
          this.chart.attachCanvas(this.canvas);

          // Overlay canvas for JS-rendered features (volume profile)
          if (this.overlayCanvas) this.overlayCanvas.remove();
          this.overlayCanvas = document.createElement("canvas");
          this.overlayCanvas.style.cssText = "position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:3;";
          this.container.appendChild(this.overlayCanvas);

          this._bindEvents();
          this._startLoop();

          // Sync size once layout settles
          requestAnimationFrame(() => {
            if (this.chart) {
              this.chart.resize(this.container.clientWidth, this.container.clientHeight);
            }
          });

          new ResizeObserver(() => {
            if (this.chart) this.chart.resize(this.container.clientWidth, this.container.clientHeight);
          }).observe(this.container);
        }

        _coords(e) {
          const r = this.canvas.getBoundingClientRect();
          return { x: e.clientX - r.left, y: e.clientY - r.top };
        }

        _crosshairInfo(x, y) {
          if (!this.chart) return null;
          this.chart.onMouseMove(x, y);
          const raw = this.chart.getCrosshairInfo?.();
          if (!raw) return null;
          return typeof raw === "string" ? JSON.parse(raw) : raw;
        }

        _handleDrawClick(x, y) {
          const info = this._crosshairInfo(x, y);
          if (!info) return;
          const price = info.price ?? info.ohlcv?.close;
          const time  = info.time;

          if (this.drawingMode === "hline" && price != null) {
            this.chart.createHorizontalLine(`hl-${++this._toolCount}`, price);
            this.onDrawingPlaced?.("done");

          } else if (this.drawingMode === "vline" && time != null) {
            this.chart.createVerticalLine(`vl-${++this._toolCount}`, BigInt(time));
            this.onDrawingPlaced?.("done");

          } else if (this.drawingMode === "trendline") {
            if (!this._trendStart) {
              this._trendStart = { time, price };
              this.onDrawingPlaced?.("trendline-step1");
            } else {
              this.chart.createTrendLine(
                `tl-${++this._toolCount}`,
                BigInt(this._trendStart.time), this._trendStart.price,
                BigInt(time), price
              );
              this._trendStart = null;
              this.onDrawingPlaced?.("done");
            }
          } else if (this.drawingMode === "alert" && price != null) {
            // Notify Alpine component which owns the alerts state
            this.onAlertPlace?.(price);
            this.onDrawingPlaced?.("done");
          }
        }

        _bindEvents() {
          const el = this.canvas;
          const c  = this.chart;

          el.addEventListener("mousemove", (e) => {
            const {x,y} = this._coords(e);
            c.onMouseMove(x, y);
            if (this.onCrosshair) this.onCrosshair(c.getCrosshairInfo?.());
          });
          el.addEventListener("mouseleave", () => {
            c.onMouseLeave?.();
            this.onCrosshair?.(null);
          });
          el.addEventListener("mousedown", (e) => {
            const {x,y} = this._coords(e);
            if (this.drawingMode) { this._handleDrawClick(x, y); return; }
            c.onMouseDown(x, y, e.button);
          });
          el.addEventListener("mouseup", (e) => {
            if (this.drawingMode) return;
            const {x,y} = this._coords(e);
            c.onMouseUp(x, y, e.button);
          });
          el.addEventListener("wheel", (e) => {
            e.preventDefault();
            const {x,y} = this._coords(e);
            c.onMouseWheel(x, y, e.deltaY);
          }, { passive:false });
          el.addEventListener("dblclick", () => { if (!this.drawingMode) c.fitToData?.(); });

          el.addEventListener("touchstart", (e) => {
            if (e.touches.length === 1) {
              const t=e.touches[0], r=el.getBoundingClientRect();
              c.onTouchStart?.(t.clientX-r.left, t.clientY-r.top);
              this._touchDist = null;
            } else if (e.touches.length === 2) {
              const dx=e.touches[0].clientX-e.touches[1].clientX;
              const dy=e.touches[0].clientY-e.touches[1].clientY;
              this._touchDist = Math.hypot(dx,dy);
            }
          }, { passive:true });
          el.addEventListener("touchmove", (e) => {
            if (e.touches.length === 1) {
              const t=e.touches[0], r=el.getBoundingClientRect();
              c.onTouchMove?.(t.clientX-r.left, t.clientY-r.top);
            } else if (e.touches.length===2 && this._touchDist) {
              const dx=e.touches[0].clientX-e.touches[1].clientX;
              const dy=e.touches[0].clientY-e.touches[1].clientY;
              const nd=Math.hypot(dx,dy);
              const mx=(e.touches[0].clientX+e.touches[1].clientX)/2;
              const my=(e.touches[0].clientY+e.touches[1].clientY)/2;
              const r=el.getBoundingClientRect();
              c.onMouseWheel?.(mx-r.left, my-r.top, (this._touchDist-nd)*2);
              this._touchDist = nd;
            }
          }, { passive:true });
          el.addEventListener("touchend", () => { c.onTouchEnd?.(); this._touchDist=null; });
        }

        _startLoop() {
          const loop = () => {
            if (this.chart) {
              this.chart.render();
              if (this.showVolumeProfile) this._drawVolumeProfile();
              else this._clearOverlay();
            }
            this.rafId = requestAnimationFrame(loop);
          };
          this.rafId = requestAnimationFrame(loop);
        }

        _clearOverlay() {
          if (!this.overlayCanvas) return;
          const ctx = this.overlayCanvas.getContext("2d");
          ctx.clearRect(0, 0, this.overlayCanvas.width, this.overlayCanvas.height);
        }

        _drawVolumeProfile() {
          const vp = this.getViewportInfo();
          const candles = this.getCachedCandles();
          if (!vp || !this.overlayCanvas || candles.length === 0) return;

          const dpr = window.devicePixelRatio || 1;
          const W = vp.dimensions.width;
          const H = vp.dimensions.height;

          if (this.overlayCanvas.width !== W * dpr) this.overlayCanvas.width = W * dpr;
          if (this.overlayCanvas.height !== H * dpr) this.overlayCanvas.height = H * dpr;

          const ctx = this.overlayCanvas.getContext("2d");
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.clearRect(0, 0, W, H);

          // Visible candles
          const tStart = vp.time.start, tEnd = vp.time.end;
          const visible = candles.filter(c => c.time >= tStart && c.time <= tEnd);
          if (visible.length === 0) return;

          // Build bins across visible price range
          const NUM_BINS = 28;
          const pMin = vp.price.min, pMax = vp.price.max;
          const binSize = (pMax - pMin) / NUM_BINS;
          if (binSize <= 0) return;
          const bins = new Array(NUM_BINS).fill(0);

          for (const c of visible) {
            // Distribute candle volume uniformly across bins its low–high range touches
            const lowBin  = Math.max(0, Math.floor((c.l - pMin) / binSize));
            const highBin = Math.min(NUM_BINS - 1, Math.floor((c.h - pMin) / binSize));
            if (highBin < 0 || lowBin >= NUM_BINS) continue;
            const span = Math.max(1, highBin - lowBin + 1);
            const per = (c.v || 1) / span;
            for (let i = lowBin; i <= highBin; i++) bins[i] += per;
          }

          let maxBin = 0;
          for (let i = 0; i < NUM_BINS; i++) if (bins[i] > maxBin) maxBin = bins[i];
          if (maxBin === 0) return;

          // Find POC (Point of Control = highest volume bin)
          let pocIdx = 0;
          for (let i = 0; i < NUM_BINS; i++) if (bins[i] === maxBin) { pocIdx = i; break; }

          const maxBarWidth = W * 0.22;
          const slotH = H / NUM_BINS;
          const barH = slotH * 0.88;

          ctx.globalAlpha = 1;
          for (let i = 0; i < NUM_BINS; i++) {
            if (bins[i] === 0) continue;
            const w = (bins[i] / maxBin) * maxBarWidth;
            // bin 0 = lowest price = bottom of chart
            const y = H - (i + 1) * slotH + (slotH - barH) / 2;
            ctx.fillStyle = i === pocIdx ? "rgba(255, 193, 7, 0.55)" : "rgba(88, 166, 255, 0.32)";
            ctx.fillRect(W - w, y, w, barH);
          }

          // POC line label
          const pocY = H - (pocIdx + 0.5) * slotH;
          ctx.strokeStyle = "rgba(255, 193, 7, 0.7)";
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(0, pocY);
          ctx.lineTo(W - maxBarWidth - 2, pocY);
          ctx.stroke();

          ctx.fillStyle = "rgba(255, 193, 7, 0.9)";
          ctx.font = "10px ui-monospace, monospace";
          ctx.textAlign = "left";
          ctx.textBaseline = "middle";
          ctx.fillText("POC", 6, pocY - 8);
        }

        setVolumeProfile(on) {
          this.showVolumeProfile = !!on;
          if (!on) this._clearOverlay();
        }

        setCandles(candles)  {
          if (!this.chart) return;
          this.chart.setCandles(JSON.stringify(candles));
          this._candleCache = candles.slice();
          this.fitToData();
        }
        addCandle(c)         {
          if (!this.chart) return;
          this.chart.addCandle(BigInt(c.time), c.o, c.h, c.l, c.c, c.v);
          if (this._candleCache && this._candleCache.length > 0) {
            const last = this._candleCache[this._candleCache.length - 1];
            if (last.time === c.time) this._candleCache[this._candleCache.length - 1] = c;
            else this._candleCache.push(c);
          } else {
            this._candleCache = [c];
          }
        }
        getCachedCandles()   { return this._candleCache || []; }
        getViewportInfo()    {
          if (!this.chart) return null;
          const info = this.chart.getViewportInfo();
          if (!info) return null;
          return typeof info === "string" ? JSON.parse(info) : info;
        }
        fitToData()          { this.chart?.fitToData(); }
        setLogScale(on)      { this.chart?.setLogScale(on); }
        setPriceLocked(on)   { this.chart?.setPriceLocked(on); }
        setTheme(dark)       { this.chart?.setTheme(dark); }
        setCandleStyle(s)    { this.chart?.setCandleStyle(s); }
        clearTools()         { this.chart?.clearTools(); }
        switchTimeframe(tf)  { this._createChart(tf); }
        cancelDrawing()      { this.drawingMode = null; this._trendStart = null; }
      }

      // ── Alpine component ─────────────────────────────────────
      document.addEventListener("alpine:init", () => {
        Alpine.data("demoApp", () => ({
          loading:       true,
          activeTf:      defaultTf,
          chartType:     "candlestick",
          logScale:      false,
          axisLocked:    false,
          showVolumeProfile: false,
          darkMode:      true,

          // Playback mode: off | simulate | replay
          mode:          "off",
          simInterval:   null,
          simLastCandle: { ...SEED_CANDLE },

          // Replay state
          replayPlaying: false,
          replayPos:     0,
          replayTotal:   0,
          replaySpeed:   1,
          replayInterval: null,
          replayBaseCandles: [],

          // Alerts
          alerts:        [],
          alertFlash:    false,
          _alertId:      0,

          // Layouts
          layoutsOpen:   false,
          savedLayouts:  [],
          layoutNameInput: "",

          ohlcv:         { open:null, high:null, low:null, close:null, volume:null, dir:"" },
          lastPrice:     null,
          priceDir:      "",
          chart:         null,
          drawTool:      "pointer",
          trendStep:     1,

          async init() {
            this.chart = new DemoChart(document.getElementById("chart-container"));
            this.chart.onCrosshair = (info) => this._updateOhlcv(info);
            this.chart.onAlertPlace = (price) => this.addAlertAt(price);
            this.chart.onDrawingPlaced = (ev) => {
              if (ev === "trendline-step1") { this.trendStep = 2; return; }
              this.drawTool = "pointer";
              this.trendStep = 1;
              this.chart.drawingMode = null;
            };

            await this.chart.init(this.activeTf);
            this._loadCandles(this.activeTf);
            // Set initial last price
            const raw = ALL_CANDLES[this.activeTf] || [];
            if (raw.length) this.lastPrice = raw[raw.length-1].c;
            this.loading = false;

            // Load saved layouts from localStorage
            this.savedLayouts = this._readLayouts();

            // Request notification permission for price alerts (silent if denied)
            if ("Notification" in window && Notification.permission === "default") {
              try { Notification.requestPermission(); } catch (_) {}
            }

            document.addEventListener("keydown", (e) => {
              if (e.target !== document.body && e.target.tagName !== "BODY") return;
              if (e.key === "f" || e.key === "F") this.fitToData();
              if (e.key === "l" || e.key === "L") this.toggleLogScale();
              if (e.key === "a" || e.key === "A") this.toggleAxisLock();
              if (e.key === "v" || e.key === "V") this.toggleVolumeProfile();
              if (e.key === "Escape")              this.setDrawTool("pointer");
            });
          },

          _rawCandles(tf) { return ALL_CANDLES[tf] || []; },

          _loadCandles(tf) {
            const raw = this._rawCandles(tf);
            let candles = raw;
            if (this.chartType === "ha") candles = toHeikinAshi(raw);
            else if (this.chartType === "renko") candles = toRenko(raw);
            this.chart.setCandles(candles);
          },

          switchTimeframe(tf) {
            if (tf === this.activeTf) return;
            this.activeTf = tf;
            this._stopAllPlayback();
            this.mode = "off";
            this.setDrawTool("pointer");
            this.chart.switchTimeframe(tf);
            // Re-apply current settings to new chart instance
            this.chart.setLogScale(this.logScale);
            this.chart.setTheme(this.darkMode);
            this.chart.setPriceLocked(this.axisLocked);
            this.chart.setVolumeProfile(this.showVolumeProfile);
            const wasmStyle = (this.chartType === "ha" || this.chartType === "renko") ? "candlestick" : this.chartType;
            this.chart.setCandleStyle(wasmStyle);
            this._loadCandles(tf);
            const raw = this._rawCandles(tf);
            this.simLastCandle = { ...raw[raw.length-1] };
          },

          setChartType(type) {
            this.chartType = type;
            // HA + Renko reuse the candlestick renderer; line/area/ohlc/hollow map directly
            const wasmStyle = (type === "ha" || type === "renko") ? "candlestick" : type;
            this.chart.setCandleStyle(wasmStyle);
            this._loadCandles(this.activeTf);
          },

          setDrawTool(tool) {
            this.drawTool = tool;
            this.trendStep = 1;
            this.chart.drawingMode = tool === "pointer" ? null : tool;
            this.chart._trendStart = null;
          },

          clearTools() { this.chart?.clearTools(); this.setDrawTool("pointer"); },

          drawHintText() {
            if (this.drawTool === "hline")     return "Click to place horizontal line";
            if (this.drawTool === "vline")     return "Click to place vertical line";
            if (this.drawTool === "trendline") return this.trendStep === 1
              ? "Click to set start point" : "Click to set end point";
            if (this.drawTool === "alert")     return "Click to set price alert";
            return "";
          },

          fitToData() { this.chart?.fitToData(); },

          toggleLogScale() {
            this.logScale = !this.logScale;
            this.chart?.setLogScale(this.logScale);
          },

          toggleAxisLock() {
            this.axisLocked = !this.axisLocked;
            this.chart?.setPriceLocked(this.axisLocked);
          },

          toggleVolumeProfile() {
            this.showVolumeProfile = !this.showVolumeProfile;
            this.chart?.setVolumeProfile(this.showVolumeProfile);
          },

          toggleTheme() {
            this.darkMode = !this.darkMode;
            document.body.classList.toggle("dark",  this.darkMode);
            document.body.classList.toggle("light", !this.darkMode);
            this.chart?.setTheme(this.darkMode);
          },

          // ── Mode switching ────────────────────────────────────
          setMode(m) {
            if (this.mode === m) return;
            this._stopAllPlayback();
            this.mode = m;
            if (m === "simulate") this._startSim();
            else if (m === "replay") this._startReplay();
            else this._resetToFull(); // off
          },

          _stopAllPlayback() {
            clearInterval(this.simInterval); this.simInterval = null;
            clearInterval(this.replayInterval); this.replayInterval = null;
            this.replayPlaying = false;
          },

          _resetToFull() {
            // Reload full historical candles for current tf + chart type
            this._loadCandles(this.activeTf);
            const raw = this._rawCandles(this.activeTf);
            if (raw.length) this.lastPrice = raw[raw.length - 1].c;
          },

          // ── Simulation ────────────────────────────────────────
          _startSim() {
            const tfSec = TF_SECONDS[this.activeTf] || 3600;
            const raw = this._rawCandles(this.activeTf);
            if (raw.length) this.simLastCandle = { ...raw[raw.length - 1] };
            this.simInterval = setInterval(() => {
              const prev = this.simLastCandle;
              const vol   = prev.c * (0.005 + simRand() * 0.006);
              const body  = (simRand() - 0.49) * vol;
              const open  = prev.c;
              const close = Math.max(1000, open + body);
              const wick  = simRand() * Math.abs(body) * 0.6;
              const candle = {
                time: prev.time + tfSec,
                o: Math.round(open*100)/100,
                h: Math.round((Math.max(open,close)+wick)*100)/100,
                l: Math.round(Math.max(1000, Math.min(open,close)-wick*simRand())*100)/100,
                c: Math.round(close*100)/100,
                v: Math.round(Math.max(10, 200+simRand()*400)*10)/10,
              };
              this.chart.addCandle(candle);
              this._onNewClose(candle.c);
              this.simLastCandle = candle;
            }, 1500);
          },

          // ── Replay ────────────────────────────────────────────
          _startReplay() {
            const raw = this._rawCandles(this.activeTf);
            // Apply HA/Renko transform once for replay base
            let base = raw;
            if (this.chartType === "ha")    base = toHeikinAshi(raw);
            else if (this.chartType === "renko") base = toRenko(raw);
            this.replayBaseCandles = base;
            this.replayTotal = base.length;
            // Start at ~30% of data so user sees something animated
            const start = Math.max(2, Math.floor(base.length * 0.3));
            this.replayPos = start;
            this.chart.setCandles(base.slice(0, start));
            this.replayPlaying = true;
            this._scheduleReplayTick();
          },

          _scheduleReplayTick() {
            clearInterval(this.replayInterval);
            const intervalMs = Math.max(50, 800 / this.replaySpeed);
            this.replayInterval = setInterval(() => {
              if (!this.replayPlaying) return;
              if (this.replayPos >= this.replayTotal) {
                this.replayPlaying = false;
                clearInterval(this.replayInterval);
                return;
              }
              const c = this.replayBaseCandles[this.replayPos];
              this.chart.addCandle(c);
              this._onNewClose(c.c);
              this.replayPos += 1;
            }, intervalMs);
          },

          replayToggle() {
            if (this.mode !== "replay") return;
            this.replayPlaying = !this.replayPlaying;
            if (this.replayPlaying) this._scheduleReplayTick();
          },

          replayStep() {
            if (this.mode !== "replay") return;
            if (this.replayPos >= this.replayTotal) return;
            const c = this.replayBaseCandles[this.replayPos];
            this.chart.addCandle(c);
            this._onNewClose(c.c);
            this.replayPos += 1;
          },

          replaySeek(pos) {
            if (this.mode !== "replay") return;
            const idx = Math.max(0, Math.min(this.replayTotal, Math.floor(pos)));
            this.replayPos = idx;
            // Rebuild chart from start
            this.chart.setCandles(this.replayBaseCandles.slice(0, idx));
            if (idx > 0) this.lastPrice = this.replayBaseCandles[idx - 1].c;
          },

          replayRestart() {
            if (this.mode === "replay" && this.replayPlaying) this._scheduleReplayTick();
          },

          // ── Alerts ────────────────────────────────────────────
          addAlertAt(price) {
            const current = this.lastPrice ?? price;
            const dir = price >= current ? "above" : "below";
            const id = ++this._alertId;
            this.alerts.push({ id, price, dir, triggered: false });
            // Draw horizontal line so user sees it
            const lineId = `alert-${id}`;
            this.chart?.chart?.createHorizontalLine(lineId, price);
          },

          removeAlert(idx) {
            const a = this.alerts[idx];
            if (!a) return;
            try { this.chart?.chart?.removeTool(`alert-${a.id}`); } catch (_) {}
            this.alerts.splice(idx, 1);
          },

          _checkAlerts(close) {
            for (const a of this.alerts) {
              if (a.triggered) continue;
              if ((a.dir === "above" && close >= a.price) ||
                  (a.dir === "below" && close <= a.price)) {
                a.triggered = true;
                this._fireAlert(a);
              }
            }
          },

          _fireAlert(a) {
            this.alertFlash = true;
            setTimeout(() => { this.alertFlash = false; }, 800);
            if ("Notification" in window && Notification.permission === "granted") {
              new Notification("LoomChart alert", {
                body: `Price ${a.dir} ${a.price.toFixed(2)}`,
              });
            }
          },

          _onNewClose(close) {
            const prev = this.lastPrice;
            this.lastPrice = close;
            this.priceDir = prev == null ? "" : (close > prev ? "up" : close < prev ? "dn" : "");
            this._checkAlerts(close);
          },

          // ── Layouts ───────────────────────────────────────────
          _readLayouts() {
            try {
              return JSON.parse(localStorage.getItem("loomchart-demo-layouts") || "[]");
            } catch (_) { return []; }
          },

          _writeLayouts() {
            try { localStorage.setItem("loomchart-demo-layouts", JSON.stringify(this.savedLayouts)); }
            catch (_) {}
          },

          saveLayout() {
            const name = (this.layoutNameInput || "").trim() || `Layout ${this.savedLayouts.length + 1}`;
            let wasmState = "";
            try { wasmState = this.chart?.chart?.exportState() || ""; } catch (_) {}
            const layout = {
              name,
              ts: Date.now(),
              tf: this.activeTf,
              chartType: this.chartType,
              logScale: this.logScale,
              axisLocked: this.axisLocked,
              darkMode: this.darkMode,
              wasmState,
            };
            this.savedLayouts.push(layout);
            this._writeLayouts();
            this.layoutNameInput = "";
          },

          loadLayout(idx) {
            const lo = this.savedLayouts[idx];
            if (!lo) return;
            // Stop any playback first
            this.setMode("off");
            // Apply timeframe (rebuilds chart instance)
            if (lo.tf !== this.activeTf) {
              this.activeTf = lo.tf;
              this.chart.switchTimeframe(lo.tf);
            }
            this.chartType = lo.chartType;
            this.logScale = !!lo.logScale;
            this.axisLocked = !!lo.axisLocked;
            this.darkMode = !!lo.darkMode;
            document.body.classList.toggle("dark", this.darkMode);
            document.body.classList.toggle("light", !this.darkMode);
            this.chart.setTheme(this.darkMode);
            this.chart.setLogScale(this.logScale);
            this.chart.setPriceLocked(this.axisLocked);
            const wasmStyle = (lo.chartType === "ha" || lo.chartType === "renko") ? "candlestick" : lo.chartType;
            this.chart.setCandleStyle(wasmStyle);
            // Import full WASM state if available
            if (lo.wasmState) {
              try { this.chart.chart?.importState(lo.wasmState); } catch (e) { console.warn("Import failed:", e); }
            } else {
              this._loadCandles(lo.tf);
            }
            this.layoutsOpen = false;
          },

          deleteLayout(idx) {
            this.savedLayouts.splice(idx, 1);
            this._writeLayouts();
          },

          _updateOhlcv(info) {
            if (!info) { this.ohlcv.open = null; return; }
            const v = typeof info === "string" ? JSON.parse(info) : info;
            const d = v?.ohlcv ?? v;
            if (!d) return;
            this.ohlcv = {
              open:   d.open  ?? d.o,
              high:   d.high  ?? d.h,
              low:    d.low   ?? d.l,
              close:  d.close ?? d.c,
              volume: d.volume ?? d.v,
              dir: (d.close ?? d.c) >= (d.open ?? d.o) ? "ohlcv-up" : "ohlcv-down",
            };
          },

          fmt(v) {
            if (v == null) return "—";
            return Number(v).toLocaleString("en-US", { minimumFractionDigits:2, maximumFractionDigits:2 });
          },
          fmtVol(v) {
            if (v == null) return "—";
            return v >= 1000 ? (v/1000).toFixed(1)+"K" : Number(v).toFixed(0);
          },
        }));
      });
    </script>
  </body>
</html>
