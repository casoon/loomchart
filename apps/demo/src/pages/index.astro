    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js" defer></script>

    <script define:vars={{ candleData, defaultTf, lastCandleJson }}>
      const ALL_CANDLES = JSON.parse(candleData);
      const SEED_CANDLE = JSON.parse(lastCandleJson);
      const TF_SECONDS = { "1m":60, "5m":300, "15m":900, "1h":3600, "4h":14400, "1d":86400 };

      function toHeikinAshi(candles) {
        const out = [];
        for (let i = 0; i < candles.length; i++) {
          const c = candles[i];
          const hc = (c.o + c.h + c.l + c.c) / 4;
          const ho = i === 0 ? (c.o + c.c) / 2 : (out[i-1].o + out[i-1].c) / 2;
          out.push({ time:c.time, o:ho, h:Math.max(c.h,ho,hc), l:Math.min(c.l,ho,hc), c:hc, v:c.v });
        }
        return out;
      }

      // Renko transform — fixed brick size (1% of starting price)
      function toRenko(candles) {
        if (candles.length === 0) return [];
        const startPrice = candles[0].c;
        const brick = startPrice * 0.01;
        const bricks = [];
        let last = startPrice;
        let tOffset = 0;
        for (const c of candles) {
          while (c.c >= last + brick) {
            const open = last;
            const close = last + brick;
            bricks.push({ time: c.time + tOffset, o: open, h: close, l: open, c: close, v: 0 });
            last = close;
            tOffset += 1;
          }
          while (c.c <= last - brick) {
            const open = last;
            const close = last - brick;
            bricks.push({ time: c.time + tOffset, o: open, h: open, l: close, c: close, v: 0 });
            last = close;
            tOffset += 1;
          }
        }
        return bricks;
      }

      let simSeed = 99999;
      function simRand() {
        simSeed = (Math.imul(1664525, simSeed) + 1013904223) | 0;
        return (simSeed >>> 0) / 0x100000000;
      }

      // Mock symbol catalog for the symbol-search / watchlist UI
      const MOCK_SYMBOLS = [
        { sym: "BTC/USD",  name: "Bitcoin",            last: 68432.12, ch:  1.24 },
        { sym: "ETH/USD",  name: "Ethereum",           last: 3567.45,  ch: -0.43 },
        { sym: "SOL/USD",  name: "Solana",             last: 156.78,   ch:  3.21 },
        { sym: "AAPL",     name: "Apple Inc.",         last: 187.32,   ch:  0.12 },
        { sym: "NVDA",     name: "NVIDIA Corp.",       last: 928.50,   ch:  2.31 },
        { sym: "TSLA",     name: "Tesla Inc.",         last: 245.66,   ch: -1.87 },
        { sym: "MSFT",     name: "Microsoft",          last: 412.34,   ch:  0.56 },
        { sym: "GOOGL",    name: "Alphabet",           last: 156.78,   ch:  0.34 },
        { sym: "EUR/USD",  name: "Euro vs Dollar",     last: 1.0823,   ch: -0.12 },
        { sym: "GBP/USD",  name: "Pound vs Dollar",    last: 1.2645,   ch:  0.08 },
        { sym: "XAU/USD",  name: "Gold spot",          last: 2367.45,  ch:  0.45 },
        { sym: "WTI",      name: "Crude Oil",          last: 76.32,    ch: -1.23 },
      ];

      // Wilder's RSI(period) over candle closes; returns array same length as input, with leading nulls
      function computeRSI(candles, period = 14) {
        const n = candles.length;
        const rsi = new Array(n).fill(null);
        if (n <= period) return rsi;
        let gain = 0, loss = 0;
        for (let i = 1; i <= period; i++) {
          const d = candles[i].c - candles[i - 1].c;
          if (d >= 0) gain += d; else loss -= d;
        }
        let avgG = gain / period, avgL = loss / period;
        rsi[period] = avgL === 0 ? 100 : 100 - 100 / (1 + avgG / avgL);
        for (let i = period + 1; i < n; i++) {
          const d = candles[i].c - candles[i - 1].c;
          const g = d > 0 ? d : 0, l = d < 0 ? -d : 0;
          avgG = (avgG * (period - 1) + g) / period;
          avgL = (avgL * (period - 1) + l) / period;
          rsi[i] = avgL === 0 ? 100 : 100 - 100 / (1 + avgG / avgL);
        }
        return rsi;
      }

      // Pivot detection with 'left'/'right' lookback on candle high/low
      function findPivots(candles, left = 3, right = 3) {
        const highs = [], lows = [];
        const n = candles.length;
        for (let i = left; i < n - right; i++) {
          let hMax = true, lMin = true;
          for (let k = i - left; k <= i + right; k++) {
            if (k === i) continue;
            if (candles[k].h >= candles[i].h) hMax = false;
            if (candles[k].l <= candles[i].l) lMin = false;
          }
          if (hMax) highs.push(i);
          if (lMin) lows.push(i);
        }
        return { highs, lows };
      }

      // Synthetic news events anchored to candle indices — generated once per (tf, count)
      function makeNewsEvents(candles) {
        if (!candles.length) return [];
        const titles = [
          { t: "Fed releases FOMC minutes",              s: "warn" },
          { t: "CPI prints hotter than expected",        s: "warn" },
          { t: "ECB statement: rate hold",               s: "info" },
          { t: "Major exchange outage reported",         s: "crit" },
          { t: "Whale wallet activity spike",            s: "info" },
          { t: "Crypto bill passes committee",           s: "info" },
          { t: "Stablecoin de-peg headlines",            s: "crit" },
          { t: "BoJ pivot speculation",                  s: "warn" },
          { t: "Mining hash-rate ATH",                   s: "info" },
        ];
        // Place ~1 event per 12% of the dataset
        const out = [];
        const step = Math.max(8, Math.floor(candles.length / titles.length));
        for (let i = 0; i < titles.length; i++) {
          const idx = Math.min(candles.length - 1, i * step + Math.floor(step / 2));
          out.push({ time: candles[idx].time, ...titles[i] });
        }
        return out;
      }

      // ── Thin WASM chart wrapper ──────────────────────────────
      class DemoChart {
        constructor(container) {
          this.container = container;
          this.chart = null;
          this._mod = null;
          this.rafId = null;
          this.onCrosshair = null;
          this._touchDist = null;
          this._toolCount = 0;
          this.drawingMode = null;
          this._trendStart = null;
          this.onDrawingPlaced = null;
          // Re-entrancy guard: WASM chart state must never be entered while
          // an earlier WASM call on the same object is still on the stack.
          this._inWasm = false;
          this._pendingResize = null;
          this._resizeObserver = null;
        }

        // Run a WASM call behind the re-entrancy guard. Calls attempted while
        // another WASM call is in flight are skipped rather than panicking
        // Rust with "recursive use of an object" aliasing errors.
        _wasm(fn) {
          if (!this.chart || this._inWasm) return undefined;
          this._inWasm = true;
          try {
            return fn(this.chart);
          } catch (err) {
            console.error("[chart] WASM call failed:", err);
            return undefined;
          } finally {
            this._inWasm = false;
          }
        }

        async init(timeframe) {
          const mod = await import("/wasm/trading_ui.js");
          await mod.default();
          this._mod = mod;
          this._createChart(timeframe);
        }

        _createChart(timeframe) {
          if (this.chart) { try { this.chart.free?.(); } catch(_){} }
          if (this.rafId) cancelAnimationFrame(this.rafId);
          if (this.canvas) this.canvas.remove();

          // Use actual container size
          const w = this.container.clientWidth  || 800;
          const h = this.container.clientHeight || 500;
          this.chart = new this._mod.WasmChart(w, h, timeframe);

          this.canvas = document.createElement("canvas");
          this.canvas.style.cssText = "position:absolute;top:0;left:0;width:100%;height:100%;cursor:crosshair;";
          this.container.appendChild(this.canvas);
          this.chart.attachCanvas(this.canvas);

          // Overlay canvas for JS-rendered features (volume profile)
          if (this.overlayCanvas) this.overlayCanvas.remove();
          this.overlayCanvas = document.createElement("canvas");
          this.overlayCanvas.style.cssText = "position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:3;";
          this.container.appendChild(this.overlayCanvas);

          this._bindEvents();
          this._startLoop();

          // Sync size once layout settles — applied by the render loop, never
          // synchronously, so resize cannot re-enter a borrowed chart.
          requestAnimationFrame(() => this._queueResize());

          // Replace any observer from a previous chart instance so resize
          // callbacks do not pile up across timeframe switches.
          if (this._resizeObserver) this._resizeObserver.disconnect();
          this._resizeObserver = new ResizeObserver(() => this._queueResize());
          this._resizeObserver.observe(this.container);
        }

        _queueResize() {
          if (!this.chart) return;
          this._pendingResize = {
            w: this.container.clientWidth,
            h: this.container.clientHeight,
          };
        }

        _coords(e) {
          const r = this.canvas.getBoundingClientRect();
          return { x: e.clientX - r.left, y: e.clientY - r.top };
        }

        _crosshairInfo(x, y) {
          return this._wasm((c) => {
            c.onMouseMove(x, y);
            const raw = c.getCrosshairInfo?.();
            if (!raw) return null;
            return typeof raw === "string" ? JSON.parse(raw) : raw;
          }) ?? null;
        }

        _handleDrawClick(x, y) {
          const info = this._crosshairInfo(x, y);
          if (!info) return;
          const price = info.price ?? info.ohlcv?.close;
          const time  = info.time;

          if (this.drawingMode === "hline" && price != null) {
            this._wasm((c) => c.createHorizontalLine(`hl-${++this._toolCount}`, price));
            this.onDrawingPlaced?.("done");

          } else if (this.drawingMode === "vline" && time != null) {
            this._wasm((c) => c.createVerticalLine(`vl-${++this._toolCount}`, BigInt(time)));
            this.onDrawingPlaced?.("done");

          } else if (this.drawingMode === "trendline") {
            if (!this._trendStart) {
              this._trendStart = { time, price };
              this.onDrawingPlaced?.("trendline-step1");
            } else {
              this._wasm((c) => c.createTrendLine(
                `tl-${++this._toolCount}`,
                BigInt(this._trendStart.time), this._trendStart.price,
                BigInt(time), price
              ));
              this._trendStart = null;
              this.onDrawingPlaced?.("done");
            }
          } else if (this.drawingMode === "rectangle") {
            if (!this._trendStart) {
              this._trendStart = { time, price };
              this.onDrawingPlaced?.("rectangle-step1");
            } else {
              this._wasm((c) => c.createRectangle(
                `rect-${++this._toolCount}`,
                BigInt(this._trendStart.time), this._trendStart.price,
                BigInt(time), price
              ));
              this._trendStart = null;
              this.onDrawingPlaced?.("done");
            }
          } else if (this.drawingMode === "fibonacci") {
            if (!this._trendStart) {
              this._trendStart = { time, price };
              this.onDrawingPlaced?.("fibonacci-step1");
            } else {
              this._wasm((c) => c.createFibonacci(
                `fib-${++this._toolCount}`,
                BigInt(this._trendStart.time), this._trendStart.price,
                BigInt(time), price
              ));
              this._trendStart = null;
              this.onDrawingPlaced?.("done");
            }
          } else if (this.drawingMode === "textlabel" && price != null) {
            const text = prompt("Label text:", "Note") || "Note";
            this._wasm((c) => c.createTextLabel(
              `lbl-${++this._toolCount}`,
              BigInt(time), price, text
            ));
            this.onDrawingPlaced?.("done");
          } else if (this.drawingMode === "alert" && price != null) {
            // Notify Alpine component which owns the alerts state
            this.onAlertPlace?.(price);
            this.onDrawingPlaced?.("done");
          }
        }

        _bindEvents() {
          const el = this.canvas;

          el.addEventListener("mousemove", (e) => {
            const {x,y} = this._coords(e);
            const info = this._wasm((c) => {
              c.onMouseMove(x, y);
              return c.getCrosshairInfo?.();
            });
            if (this.onCrosshair) this.onCrosshair(info);
          });
          el.addEventListener("mouseleave", () => {
            this._wasm((c) => c.onMouseLeave?.());
            this.onCrosshair?.(null);
          });
          el.addEventListener("mousedown", (e) => {
            const {x,y} = this._coords(e);
            if (this.drawingMode) { this._handleDrawClick(x, y); return; }
            this._wasm((c) => c.onMouseDown(x, y, e.button));
          });
          el.addEventListener("mouseup", (e) => {
            if (this.drawingMode) return;
            const {x,y} = this._coords(e);
            this._wasm((c) => c.onMouseUp(x, y, e.button));
          });
          el.addEventListener("wheel", (e) => {
            e.preventDefault();
            const {x,y} = this._coords(e);
            this._wasm((c) => c.onMouseWheel(x, y, e.deltaY));
          }, { passive:false });
          el.addEventListener("dblclick", () => {
            if (!this.drawingMode) this._wasm((c) => c.fitToData?.());
          });

          el.addEventListener("touchstart", (e) => {
            if (e.touches.length === 1) {
              const t=e.touches[0], r=el.getBoundingClientRect();
              this._wasm((c) => c.onTouchStart?.(t.clientX-r.left, t.clientY-r.top));
              this._touchDist = null;
            } else if (e.touches.length === 2) {
              const dx=e.touches[0].clientX-e.touches[1].clientX;
              const dy=e.touches[0].clientY-e.touches[1].clientY;
              this._touchDist = Math.hypot(dx,dy);
            }
          }, { passive:true });
          el.addEventListener("touchmove", (e) => {
            if (e.touches.length === 1) {
              const t=e.touches[0], r=el.getBoundingClientRect();
              this._wasm((c) => c.onTouchMove?.(t.clientX-r.left, t.clientY-r.top));
            } else if (e.touches.length===2 && this._touchDist) {
              const dx=e.touches[0].clientX-e.touches[1].clientX;
              const dy=e.touches[0].clientY-e.touches[1].clientY;
              const nd=Math.hypot(dx,dy);
              const mx=(e.touches[0].clientX+e.touches[1].clientX)/2;
              const my=(e.touches[0].clientY+e.touches[1].clientY)/2;
              const r=el.getBoundingClientRect();
              this._wasm((c) => c.onMouseWheel?.(mx-r.left, my-r.top, (this._touchDist-nd)*2));
              this._touchDist = nd;
            }
          }, { passive:true });
          el.addEventListener("touchend", () => {
            this._wasm((c) => c.onTouchEnd?.());
            this._touchDist=null;
          });
        }

        _startLoop() {
          const loop = () => {
            if (this.chart && !this._inWasm) {
              // Resize (if queued) and render share a single guarded span so
              // the chart is never re-entered mid-borrow.
              this._inWasm = true;
              try {
                if (this._pendingResize) {
                  const { w, h } = this._pendingResize;
                  this._pendingResize = null;
                  if (w > 0 && h > 0) {
                    this.chart.resize(w, h);
                    // resize() may clear the canvas; fitToData() re-marks dirty
                    // so the render() below actually redraws the frame.
                    if (this._candleCache?.length) this.chart.fitToData?.();
                  }
                }
                this.chart.render();
              } catch (err) {
                console.error("[chart] render loop failed:", err);
              } finally {
                this._inWasm = false;
              }
            }
            if (this.chart) {
              const anyOverlay = this.showVolumeProfile || this.vpMode === "vpsv"
                              || this.showStrategy || this.showNews
                              || this.showDivergence || this.showPatterns
                              || this.showMTF;
              if (anyOverlay) {
                this._clearOverlay();
                this._ensureOverlaySize();
                if (this.vpMode === "vpsv")        this._drawVolumeProfileSession();
                else if (this.showVolumeProfile)   this._drawVolumeProfile();
                if (this.showPatterns)             this._drawPatterns();
                if (this.showDivergence)           this._drawDivergence();
                if (this.showMTF)                  this._drawMTF();
                if (this.showStrategy)             this._drawStrategy();
                if (this.showNews)                 this._drawNews();
              } else if (this._overlayDirty) {
                this._clearOverlay();
                this._overlayDirty = false;
              }
            }
            this.rafId = requestAnimationFrame(loop);
          };
          this.rafId = requestAnimationFrame(loop);
        }

        _ensureOverlaySize() {
          const vp = this.getViewportInfo();
          if (!vp || !this.overlayCanvas) return;
          const dpr = window.devicePixelRatio || 1;
          const W = vp.dimensions.width, H = vp.dimensions.height;
          if (this.overlayCanvas.width !== W * dpr) this.overlayCanvas.width = W * dpr;
          if (this.overlayCanvas.height !== H * dpr) this.overlayCanvas.height = H * dpr;
        }

        _clearOverlay() {
          if (!this.overlayCanvas) return;
          const ctx = this.overlayCanvas.getContext("2d");
          ctx.clearRect(0, 0, this.overlayCanvas.width, this.overlayCanvas.height);
        }

        _drawVolumeProfile() {
          const vp = this.getViewportInfo();
          const candles = this.getCachedCandles();
          if (!vp || candles.length === 0) return;
          const tStart = vp.time.start, tEnd = vp.time.end;
          const visible = candles.filter(c => c.time >= tStart && c.time <= tEnd);
          this._drawVPCore(visible, "VPVR");
        }

        _drawVPCore(candles, label) {
          const vp = this.getViewportInfo();
          if (!vp || !this.overlayCanvas || !candles?.length) return;
          const dpr = window.devicePixelRatio || 1;
          const W = vp.dimensions.width, H = vp.dimensions.height;
          const ctx = this.overlayCanvas.getContext("2d");
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          const NUM_BINS = 28;
          const pMin = vp.price.min, pMax = vp.price.max;
          const binSize = (pMax - pMin) / NUM_BINS;
          if (binSize <= 0) return;
          const bins = new Array(NUM_BINS).fill(0);

          for (const c of candles) {
            const lowBin  = Math.max(0, Math.floor((c.l - pMin) / binSize));
            const highBin = Math.min(NUM_BINS - 1, Math.floor((c.h - pMin) / binSize));
            if (highBin < 0 || lowBin >= NUM_BINS) continue;
            const span = Math.max(1, highBin - lowBin + 1);
            const per = (c.v || 1) / span;
            for (let i = lowBin; i <= highBin; i++) bins[i] += per;
          }

          let maxBin = 0;
          for (let i = 0; i < NUM_BINS; i++) if (bins[i] > maxBin) maxBin = bins[i];
          if (maxBin === 0) return;

          let pocIdx = 0;
          for (let i = 0; i < NUM_BINS; i++) if (bins[i] === maxBin) { pocIdx = i; break; }

          const maxBarWidth = W * 0.22;
          const slotH = H / NUM_BINS;
          const barH = slotH * 0.88;

          ctx.globalAlpha = 1;
          for (let i = 0; i < NUM_BINS; i++) {
            if (bins[i] === 0) continue;
            const w = (bins[i] / maxBin) * maxBarWidth;
            const y = H - (i + 1) * slotH + (slotH - barH) / 2;
            ctx.fillStyle = i === pocIdx ? "rgba(255, 193, 7, 0.55)" : "rgba(88, 166, 255, 0.32)";
            ctx.fillRect(W - w, y, w, barH);
          }

          const pocY = H - (pocIdx + 0.5) * slotH;
          ctx.strokeStyle = "rgba(255, 193, 7, 0.7)";
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(0, pocY);
          ctx.lineTo(W - maxBarWidth - 2, pocY);
          ctx.stroke();

          ctx.fillStyle = "rgba(255, 193, 7, 0.9)";
          ctx.font = "10px ui-monospace, monospace";
          ctx.textAlign = "left";
          ctx.textBaseline = "middle";
          ctx.fillText(`POC · ${label}`, 6, pocY - 8);
        }

        setVolumeProfile(on) {
          this.showVolumeProfile = !!on;
          this.vpMode = on ? "vpvr" : "off";
          this._overlayDirty = true;
        }

        setStrategy(on) {
          this.showStrategy = !!on;
          this._overlayDirty = true;
        }

        _drawStrategy() {
          const vp = this.getViewportInfo();
          const candles = this.getCachedCandles();
          if (!vp || !candles.length || candles.length < 21) return;

          const dpr = window.devicePixelRatio || 1;
          const W = vp.dimensions.width, H = vp.dimensions.height;
          const ctx = this.overlayCanvas.getContext("2d");
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          // Linear time→x / price→y (matches non-log chart)
          const tStart = vp.time.start, tEnd = vp.time.end;
          const pMin = vp.price.min, pMax = vp.price.max;
          const t2x = (t) => (t - tStart) / (tEnd - tStart) * W;
          const p2y = (p) => (pMax - p) / (pMax - pMin) * H;

          // Compute SMAs incrementally
          const FAST = 5, SLOW = 20;
          const fast = new Array(candles.length);
          const slow = new Array(candles.length);
          let sumF = 0, sumS = 0;
          for (let i = 0; i < candles.length; i++) {
            sumF += candles[i].c;
            if (i >= FAST) sumF -= candles[i - FAST].c;
            if (i >= FAST - 1) fast[i] = sumF / FAST;
            sumS += candles[i].c;
            if (i >= SLOW) sumS -= candles[i - SLOW].c;
            if (i >= SLOW - 1) slow[i] = sumS / SLOW;
          }

          // Helper: build polyline of visible points
          const buildLine = (arr) => {
            const pts = [];
            for (let i = 0; i < candles.length; i++) {
              if (arr[i] == null) continue;
              const t = candles[i].time;
              if (t < tStart || t > tEnd) continue;
              pts.push([t2x(t), p2y(arr[i])]);
            }
            return pts;
          };

          const drawLine = (pts, color, width) => {
            if (pts.length < 2) return;
            ctx.strokeStyle = color;
            ctx.lineWidth = width;
            ctx.lineJoin = "round";
            ctx.lineCap = "round";
            ctx.beginPath();
            ctx.moveTo(pts[0][0], pts[0][1]);
            for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i][0], pts[i][1]);
            ctx.stroke();
          };

          drawLine(buildLine(fast), "rgba(88,166,255,0.85)", 1.5);
          drawLine(buildLine(slow), "rgba(227,179,65,0.85)", 1.5);

          // Find crossovers and draw entry/exit markers
          let lastSig = null;
          for (let i = SLOW; i < candles.length; i++) {
            const t = candles[i].time;
            if (t < tStart || t > tEnd) continue;
            const prevD = (fast[i-1] ?? 0) - (slow[i-1] ?? 0);
            const curD  = (fast[i]   ?? 0) - (slow[i]   ?? 0);
            let kind = null;
            if (prevD <= 0 && curD > 0) kind = "buy";
            else if (prevD >= 0 && curD < 0) kind = "sell";
            if (!kind) continue;
            if (lastSig === kind) continue; // dedupe consecutive same-direction
            lastSig = kind;

            const x = t2x(t);
            const y = p2y(candles[i].c);

            // Triangle marker
            ctx.beginPath();
            if (kind === "buy") {
              // Up triangle below candle
              const yT = y + 14;
              ctx.moveTo(x, yT);
              ctx.lineTo(x - 6, yT + 9);
              ctx.lineTo(x + 6, yT + 9);
              ctx.closePath();
              ctx.fillStyle = "rgba(63,185,80,0.95)";
              ctx.fill();
              ctx.fillStyle = "#fff";
              ctx.font = "bold 9px ui-monospace, monospace";
              ctx.textAlign = "center";
              ctx.textBaseline = "middle";
              ctx.fillText("B", x, yT + 6);
            } else {
              // Down triangle above candle
              const yT = y - 14;
              ctx.moveTo(x, yT);
              ctx.lineTo(x - 6, yT - 9);
              ctx.lineTo(x + 6, yT - 9);
              ctx.closePath();
              ctx.fillStyle = "rgba(248,81,73,0.95)";
              ctx.fill();
              ctx.fillStyle = "#fff";
              ctx.font = "bold 9px ui-monospace, monospace";
              ctx.textAlign = "center";
              ctx.textBaseline = "middle";
              ctx.fillText("S", x, yT - 6);
            }
          }

          // Legend
          ctx.font = "10px ui-monospace, monospace";
          ctx.textAlign = "left";
          ctx.textBaseline = "top";
          ctx.fillStyle = "rgba(88,166,255,0.9)";
          ctx.fillText("— SMA 5",  8, 8);
          ctx.fillStyle = "rgba(227,179,65,0.9)";
          ctx.fillText("— SMA 20", 8, 22);
          ctx.fillStyle = "rgba(150,160,170,0.7)";
          ctx.fillText("▲ Buy  ▼ Sell", 8, 36);
        }

        _drawNews() {
          const vp = this.getViewportInfo();
          const candles = this.getCachedCandles();
          if (!vp || !candles.length || !this.newsEvents?.length) return;
          const dpr = window.devicePixelRatio || 1;
          const W = vp.dimensions.width, H = vp.dimensions.height;
          const ctx = this.overlayCanvas.getContext("2d");
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          const tStart = vp.time.start, tEnd = vp.time.end;
          const t2x = (t) => (t - tStart) / (tEnd - tStart) * W;
          const colors = { info: "rgba(88,166,255,0.6)", warn: "rgba(227,179,65,0.7)", crit: "rgba(248,81,73,0.7)" };

          ctx.font = "9px ui-monospace, monospace";
          ctx.textAlign = "center";
          ctx.textBaseline = "top";
          for (const ev of this.newsEvents) {
            if (ev.time < tStart || ev.time > tEnd) continue;
            const x = t2x(ev.time);
            const color = colors[ev.s] || colors.info;
            // Dashed vertical line
            ctx.strokeStyle = color;
            ctx.lineWidth = 1;
            ctx.setLineDash([3, 3]);
            ctx.beginPath();
            ctx.moveTo(x, 20);
            ctx.lineTo(x, H - 8);
            ctx.stroke();
            ctx.setLineDash([]);
            // Marker bubble at top
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.arc(x, 14, 7, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = "#fff";
            ctx.fillText("N", x, 11);
          }
        }

        _drawPatterns() {
          const vp = this.getViewportInfo();
          const candles = this.getCachedCandles();
          if (!vp || candles.length < 30) return;
          const dpr = window.devicePixelRatio || 1;
          const W = vp.dimensions.width, H = vp.dimensions.height;
          const ctx = this.overlayCanvas.getContext("2d");
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          const tStart = vp.time.start, tEnd = vp.time.end;
          const pMin = vp.price.min, pMax = vp.price.max;
          const t2x = (t) => (t - tStart) / (tEnd - tStart) * W;
          const p2y = (p) => (pMax - p) / (pMax - pMin) * H;

          if (!this._cachedPatterns || this._cachedPatterns.len !== candles.length) {
            const pivots = findPivots(candles, 4, 4);
            const patterns = [];

            // Double tops
            for (let k = 1; k < pivots.highs.length; k++) {
              const a = pivots.highs[k - 1], b = pivots.highs[k];
              if (b - a < 5 || b - a > 80) continue;
              const ha = candles[a].h, hb = candles[b].h;
              if (Math.abs(ha - hb) / ha > 0.015) continue;
              // Find lowest low between a and b
              let minLow = Infinity, minIdx = -1;
              for (let i = a + 1; i < b; i++) if (candles[i].l < minLow) { minLow = candles[i].l; minIdx = i; }
              if (minIdx === -1) continue;
              if ((Math.min(ha, hb) - minLow) / Math.min(ha, hb) < 0.015) continue;
              patterns.push({ kind: "double-top", a, b, neckIdx: minIdx, neckPrice: minLow, topPrice: Math.max(ha, hb) });
            }

            // Double bottoms
            for (let k = 1; k < pivots.lows.length; k++) {
              const a = pivots.lows[k - 1], b = pivots.lows[k];
              if (b - a < 5 || b - a > 80) continue;
              const la = candles[a].l, lb = candles[b].l;
              if (Math.abs(la - lb) / la > 0.015) continue;
              let maxHigh = -Infinity, maxIdx = -1;
              for (let i = a + 1; i < b; i++) if (candles[i].h > maxHigh) { maxHigh = candles[i].h; maxIdx = i; }
              if (maxIdx === -1) continue;
              if ((maxHigh - Math.max(la, lb)) / Math.max(la, lb) < 0.015) continue;
              patterns.push({ kind: "double-bottom", a, b, neckIdx: maxIdx, neckPrice: maxHigh, topPrice: Math.min(la, lb) });
            }

            this._cachedPatterns = { len: candles.length, patterns };
          }

          for (const p of this._cachedPatterns.patterns) {
            const ca = candles[p.a], cb = candles[p.b], cn = candles[p.neckIdx];
            if (cb.time < tStart || ca.time > tEnd) continue;

            const xa = t2x(ca.time);
            const xb = t2x(cb.time);
            const xn = t2x(cn.time);
            const isTop = p.kind === "double-top";
            const ya = p2y(isTop ? ca.h : ca.l);
            const yb = p2y(isTop ? cb.h : cb.l);
            const yn = p2y(p.neckPrice);
            const color = isTop ? "rgba(248,81,73,0.85)" : "rgba(63,185,80,0.85)";

            // Arc connecting two peaks/troughs
            ctx.strokeStyle = color;
            ctx.lineWidth = 1.5;
            ctx.setLineDash([5, 4]);
            ctx.beginPath();
            ctx.moveTo(xa, ya);
            ctx.quadraticCurveTo((xa + xb) / 2, isTop ? ya - 20 : ya + 20, xb, yb);
            ctx.stroke();
            ctx.setLineDash([]);

            // Neckline
            ctx.strokeStyle = color;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(xa, yn);
            ctx.lineTo(xb, yn);
            ctx.stroke();

            // Label
            ctx.font = "bold 10px ui-monospace, monospace";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillStyle = color;
            const labelY = isTop ? Math.min(ya, yb) - 12 : Math.max(ya, yb) + 14;
            ctx.fillText(isTop ? "Double Top" : "Double Bottom", (xa + xb) / 2, labelY);
          }
        }

        setPatterns(on) {
          this.showPatterns = !!on;
          this._cachedPatterns = null;
          this._overlayDirty = true;
        }

        setMTF(on, higherCandles, higherTfLabel) {
          this.showMTF = !!on;
          this._mtfCandles = higherCandles || null;
          this._mtfTfLabel = higherTfLabel || "";
          this._overlayDirty = true;
        }

        _drawMTF() {
          if (!this._mtfCandles?.length) return;
          const vp = this.getViewportInfo();
          if (!vp) return;
          const W = vp.dimensions.width, H = vp.dimensions.height;
          const dpr = window.devicePixelRatio || 1;
          const ctx = this.overlayCanvas.getContext("2d");
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          const tStart = vp.time.start, tEnd = vp.time.end;
          const pMin = vp.price.min, pMax = vp.price.max;
          const t2x = (t) => (t - tStart) / (tEnd - tStart) * W;
          const p2y = (p) => (pMax - p) / (pMax - pMin) * H;

          // SMA(20) on higher-tf candles
          const period = 20;
          const n = this._mtfCandles.length;
          if (n < period) return;
          const sma = new Array(n).fill(null);
          let sum = 0;
          for (let i = 0; i < n; i++) {
            sum += this._mtfCandles[i].c;
            if (i >= period) sum -= this._mtfCandles[i - period].c;
            if (i >= period - 1) sma[i] = sum / period;
          }

          const pts = [];
          for (let i = 0; i < n; i++) {
            if (sma[i] == null) continue;
            const t = this._mtfCandles[i].time;
            if (t < tStart || t > tEnd) continue;
            pts.push([t2x(t), p2y(sma[i])]);
          }
          if (pts.length < 2) return;

          ctx.strokeStyle = "rgba(255, 140, 0, 0.9)";
          ctx.lineWidth = 2.5;
          ctx.lineJoin = "round";
          ctx.lineCap  = "round";
          ctx.beginPath();
          ctx.moveTo(pts[0][0], pts[0][1]);
          for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i][0], pts[i][1]);
          ctx.stroke();

          ctx.font = "10px ui-monospace, monospace";
          ctx.fillStyle = "rgba(255, 140, 0, 0.95)";
          ctx.textAlign = "left";
          ctx.textBaseline = "top";
          ctx.fillText(`— SMA 20 (${this._mtfTfLabel})`, 8, 50);
        }

        _drawDivergence() {
          const vp = this.getViewportInfo();
          const candles = this.getCachedCandles();
          if (!vp || candles.length < 30) return;
          const dpr = window.devicePixelRatio || 1;
          const W = vp.dimensions.width, H = vp.dimensions.height;
          const ctx = this.overlayCanvas.getContext("2d");
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          const tStart = vp.time.start, tEnd = vp.time.end;
          const pMin = vp.price.min, pMax = vp.price.max;
          const t2x = (t) => (t - tStart) / (tEnd - tStart) * W;
          const p2y = (p) => (pMax - p) / (pMax - pMin) * H;

          // Compute RSI + pivots once
          if (!this._cachedDivergence || this._cachedDivergence.len !== candles.length) {
            const rsi = computeRSI(candles, 14);
            const pivots = findPivots(candles, 3, 3);
            const divs = [];
            // Bearish divergence: consecutive price-highs make HH but RSI makes LH
            for (let k = 1; k < pivots.highs.length; k++) {
              const a = pivots.highs[k - 1], b = pivots.highs[k];
              if (rsi[a] == null || rsi[b] == null) continue;
              if (b - a < 4 || b - a > 60) continue;
              if (candles[b].h > candles[a].h && rsi[b] < rsi[a] - 2) {
                divs.push({ kind: "bear", a, b });
              }
            }
            // Bullish divergence: consecutive price-lows make LL but RSI makes HL
            for (let k = 1; k < pivots.lows.length; k++) {
              const a = pivots.lows[k - 1], b = pivots.lows[k];
              if (rsi[a] == null || rsi[b] == null) continue;
              if (b - a < 4 || b - a > 60) continue;
              if (candles[b].l < candles[a].l && rsi[b] > rsi[a] + 2) {
                divs.push({ kind: "bull", a, b });
              }
            }
            this._cachedDivergence = { len: candles.length, divs };
          }

          for (const d of this._cachedDivergence.divs) {
            const ca = candles[d.a], cb = candles[d.b];
            if (ca.time < tStart || cb.time > tEnd) continue;
            const xa = t2x(ca.time), xb = t2x(cb.time);
            const ya = d.kind === "bear" ? p2y(ca.h) : p2y(ca.l);
            const yb = d.kind === "bear" ? p2y(cb.h) : p2y(cb.l);
            const color = d.kind === "bear" ? "rgba(248,81,73,0.9)" : "rgba(63,185,80,0.9)";

            ctx.strokeStyle = color;
            ctx.lineWidth = 1.5;
            ctx.setLineDash([4, 3]);
            ctx.beginPath();
            ctx.moveTo(xa, ya);
            ctx.lineTo(xb, yb);
            ctx.stroke();
            ctx.setLineDash([]);

            // Dots at ends
            ctx.fillStyle = color;
            ctx.beginPath(); ctx.arc(xa, ya, 3, 0, Math.PI * 2); ctx.fill();
            ctx.beginPath(); ctx.arc(xb, yb, 3, 0, Math.PI * 2); ctx.fill();

            // Label
            const label = d.kind === "bear" ? "Bear Div" : "Bull Div";
            const ly = d.kind === "bear" ? Math.min(ya, yb) - 8 : Math.max(ya, yb) + 14;
            ctx.font = "bold 10px ui-monospace, monospace";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillStyle = color;
            ctx.fillText(label, (xa + xb) / 2, ly);
          }
        }

        _drawVolumeProfileSession() {
          const vp = this.getViewportInfo();
          const candles = this.getCachedCandles();
          if (!vp || candles.length === 0) return;
          const tEnd = vp.time.end;
          // Session = last 24h up to viewport end
          const sessionStart = tEnd - 86400;
          const sessionCandles = candles.filter(c => c.time >= sessionStart && c.time <= tEnd);
          if (sessionCandles.length === 0) return;
          this._drawVPCore(sessionCandles, "session");
        }

        setNews(on, events) {
          this.showNews = !!on;
          if (events) this.newsEvents = events;
          this._overlayDirty = true;
        }

        setDivergence(on) {
          this.showDivergence = !!on;
          this._cachedDivergence = null;
          this._overlayDirty = true;
        }

        setVPMode(mode) {
          // mode: 'off' | 'vpvr' | 'vpsv'
          this.vpMode = mode;
          this.showVolumeProfile = (mode !== "off");
          this._overlayDirty = true;
        }

        setCandles(candles)  {
          if (!this.chart) return;
          this.chart.setCandles(JSON.stringify(candles));
          this._candleCache = candles.slice();
          this.fitToData();
        }
        addCandle(c)         {
          if (!this.chart) return;
          this.chart.addCandle(BigInt(c.time), c.o, c.h, c.l, c.c, c.v);
          if (this._candleCache && this._candleCache.length > 0) {
            const last = this._candleCache[this._candleCache.length - 1];
            if (last.time === c.time) this._candleCache[this._candleCache.length - 1] = c;
            else this._candleCache.push(c);
          } else {
            this._candleCache = [c];
          }
        }
        getCachedCandles()   { return this._candleCache || []; }
        getViewportInfo()    {
          const info = this._wasm((c) => c.getViewportInfo());
          if (!info) return null;
          return typeof info === "string" ? JSON.parse(info) : info;
        }
        fitToData()          { this.chart?.fitToData(); }
        setLogScale(on)      { this.chart?.setLogScale(on); }
        setPriceLocked(on)   { this.chart?.setPriceLocked(on); }
        setTheme(dark)       { this.chart?.setTheme(dark); }
        setCandleStyle(s)    { this.chart?.setCandleStyle(s); }
        clearTools()         { this.chart?.clearTools(); }
        switchTimeframe(tf)  { this._createChart(tf); }
        cancelDrawing()      { this.drawingMode = null; this._trendStart = null; }
      }

      // ── Alpine component ─────────────────────────────────────
      document.addEventListener("alpine:init", () => {
        Alpine.data("demoApp", () => ({
          loading:       true,
          activeTf:      defaultTf,
          chartType:     "candlestick",
          logScale:      false,
          axisLocked:    false,
          showVolumeProfile: false,
          vpMode:        "off",
          showStrategy:  false,
          showNews:      false,
          showDivergence: false,
          showPatterns:  false,
          showMTF:       false,
          darkMode:      true,

          // Playback mode: off | simulate | replay
          mode:          "off",
          simInterval:   null,
          simLastCandle: { ...SEED_CANDLE },

          // Replay state
          replayPlaying: false,
          replayPos:     0,
          replayTotal:   0,
          replaySpeed:   1,
          replayInterval: null,
          replayBaseCandles: [],

          // Alerts
          alerts:        [],
          alertFlash:    false,
          _alertId:      0,

          // Layouts
          layoutsOpen:   false,
          savedLayouts:  [],
          layoutNameInput: "",

          // Bar spacing (chart settings)
          barSpacing:    0,

          // Symbol search / watchlist (#31, #32)
          symbolsOpen:    false,
          symbolQuery:    "",
          selectedSymbol: "BTC / USD",

          ohlcv:         { open:null, high:null, low:null, close:null, volume:null, dir:"" },
          lastPrice:     null,
          priceDir:      "",
          chart:         null,
          drawTool:      "pointer",
          trendStep:     1,

          async init() {
            this.chart = new DemoChart(document.getElementById("chart-container"));
            this.chart.onCrosshair = (info) => this._updateOhlcv(info);
            this.chart.onAlertPlace = (price) => this.addAlertAt(price);
            this.chart.onDrawingPlaced = (ev) => {
              if (ev === "trendline-step1" || ev === "rectangle-step1" || ev === "fibonacci-step1") {
                this.trendStep = 2; return;
              }
              this.drawTool = "pointer";
              this.trendStep = 1;
              this.chart.drawingMode = null;
            };

            await this.chart.init(this.activeTf);
            this._loadCandles(this.activeTf);
            // Set initial last price
            const raw = ALL_CANDLES[this.activeTf] || [];
            if (raw.length) this.lastPrice = raw[raw.length-1].c;
            this.loading = false;

            // Load saved layouts from localStorage
            this.savedLayouts = this._readLayouts();

            // Request notification permission for price alerts (silent if denied)
            if ("Notification" in window && Notification.permission === "default") {
              try { Notification.requestPermission(); } catch (_) {}
            }

            document.addEventListener("keydown", (e) => {
              // Undo/Redo — fires unless user is in an input field
              if (e.ctrlKey || e.metaKey) {
                const tag = e.target?.tagName?.toUpperCase();
                if (tag !== "INPUT" && tag !== "TEXTAREA" && tag !== "SELECT") {
                  if (e.key === "z" && !e.shiftKey) {
                    e.preventDefault();
                    this.chart._wasm(c => c.undo?.());
                    return;
                  }
                  if (e.key === "y" || (e.key === "z" && e.shiftKey)) {
                    e.preventDefault();
                    this.chart._wasm(c => c.redo?.());
                    return;
                  }
                }
              }
              if (e.target !== document.body && e.target.tagName !== "BODY") return;
              if (e.key === "f" || e.key === "F") this.fitToData();
              if (e.key === "l" || e.key === "L") this.toggleLogScale();
              if (e.key === "a" || e.key === "A") this.toggleAxisLock();
              if (e.key === "v" || e.key === "V") this.toggleVolumeProfile();
              if (e.key === "s" || e.key === "S") this.toggleStrategy();
              if (e.key === "d" || e.key === "D") this.toggleDivergence();
              if (e.key === "p" || e.key === "P") this.togglePatterns();
              if (e.key === "m" || e.key === "M") this.toggleMTF();
              if (e.key === "n" || e.key === "N") this.toggleNews();
              if (e.key === "Escape")              this.setDrawTool("pointer");
            });
          },

          _rawCandles(tf) { return ALL_CANDLES[tf] || []; },

          _loadCandles(tf) {
            const raw = this._rawCandles(tf);
            let candles = raw;
            if (this.chartType === "ha") candles = toHeikinAshi(raw);
            else if (this.chartType === "renko") candles = toRenko(raw);
            this.chart.setCandles(candles);
          },

          switchTimeframe(tf) {
            if (tf === this.activeTf) return;
            this.activeTf = tf;
            this._stopAllPlayback();
            this.mode = "off";
            this.setDrawTool("pointer");
            this.chart.switchTimeframe(tf);
            // Re-apply current settings to new chart instance
            this.chart.setLogScale(this.logScale);
            this.chart.setTheme(this.darkMode);
            this.chart.setPriceLocked(this.axisLocked);
            this.chart.setVPMode(this.vpMode);
            this.chart.setStrategy(this.showStrategy);
            this.chart.setDivergence(this.showDivergence);
            this.chart.setPatterns(this.showPatterns);
            this._applyMTF();
            // Rebuild news cache for this timeframe
            this._newsCache = makeNewsEvents(this._rawCandles(tf));
            this._newsCacheTf = tf;
            this.chart.setNews(this.showNews, this._newsCache);
            const wasmStyle = (this.chartType === "ha" || this.chartType === "renko") ? "candlestick" : this.chartType;
            this.chart.setCandleStyle(wasmStyle);
            this._loadCandles(tf);
            const raw = this._rawCandles(tf);
            this.simLastCandle = { ...raw[raw.length-1] };
          },

          setChartType(type) {
            this.chartType = type;
            // HA + Renko reuse the candlestick renderer; line/area/ohlc/hollow map directly
            const wasmStyle = (type === "ha" || type === "renko") ? "candlestick" : type;
            this.chart.setCandleStyle(wasmStyle);
            this._loadCandles(this.activeTf);
          },

          setDrawTool(tool) {
            this.drawTool = tool;
            this.trendStep = 1;
            this.chart.drawingMode = tool === "pointer" ? null : tool;
            this.chart._trendStart = null;
          },

          clearTools() { this.chart?.clearTools(); this.setDrawTool("pointer"); },

          drawHintText() {
            if (this.drawTool === "hline")      return "Click to place horizontal line";
            if (this.drawTool === "vline")      return "Click to place vertical line";
            if (this.drawTool === "trendline")  return this.trendStep === 1
              ? "Click to set start point" : "Click to set end point";
            if (this.drawTool === "rectangle")  return this.trendStep === 1
              ? "Click to set first corner" : "Click to set opposite corner";
            if (this.drawTool === "fibonacci")  return this.trendStep === 1
              ? "Click to set high point" : "Click to set low point";
            if (this.drawTool === "textlabel")  return "Click to place text label";
            if (this.drawTool === "alert")      return "Click to set price alert";
            return "";
          },

          fitToData() { this.chart?.fitToData(); },

          setBarSpacing(px) { this.chart?._wasm(c => c.setBarSpacing?.(px)); },

          toggleLogScale() {
            this.logScale = !this.logScale;
            this.chart?.setLogScale(this.logScale);
          },

          toggleAxisLock() {
            this.axisLocked = !this.axisLocked;
            this.chart?.setPriceLocked(this.axisLocked);
          },

          toggleVolumeProfile() {
            // Legacy single-toggle; map to VPVR
            this.setVPMode(this.vpMode === "off" ? "vpvr" : "off");
          },

          setVPMode(mode) {
            this.vpMode = mode;
            this.showVolumeProfile = mode !== "off";
            this.chart?.setVPMode(mode);
          },

          toggleStrategy() {
            this.showStrategy = !this.showStrategy;
            this.chart?.setStrategy(this.showStrategy);
          },

          toggleNews() {
            this.showNews = !this.showNews;
            if (this.showNews && (!this._newsCache || this._newsCacheTf !== this.activeTf)) {
              this._newsCache = makeNewsEvents(this.chart?.getCachedCandles() || []);
              this._newsCacheTf = this.activeTf;
            }
            this.chart?.setNews(this.showNews, this._newsCache);
          },

          toggleDivergence() {
            this.showDivergence = !this.showDivergence;
            this.chart?.setDivergence(this.showDivergence);
          },

          togglePatterns() {
            this.showPatterns = !this.showPatterns;
            this.chart?.setPatterns(this.showPatterns);
          },

          toggleMTF() {
            this.showMTF = !this.showMTF;
            this._applyMTF();
          },

          _applyMTF() {
            if (!this.showMTF) { this.chart?.setMTF(false, null, ""); return; }
            const order = ["1m","5m","15m","1h","4h","1d"];
            const idx = order.indexOf(this.activeTf);
            if (idx < 0 || idx >= order.length - 1) {
              // No higher tf available; just label "n/a"
              this.chart?.setMTF(true, [], "n/a");
              return;
            }
            // Step up by 2 levels if available, else 1
            const targetIdx = Math.min(order.length - 1, idx + 2);
            const higherTf = order[targetIdx];
            const higherCandles = ALL_CANDLES[higherTf] || [];
            this.chart?.setMTF(true, higherCandles, higherTf);
          },

          toggleTheme() {
            this.darkMode = !this.darkMode;
            document.body.classList.toggle("dark",  this.darkMode);
            document.body.classList.toggle("light", !this.darkMode);
            this.chart?.setTheme(this.darkMode);
          },

          // ── Mode switching ────────────────────────────────────
          setMode(m) {
            if (this.mode === m) return;
            this._stopAllPlayback();
            this.mode = m;
            if (m === "simulate") this._startSim();
            else if (m === "replay") this._startReplay();
            else this._resetToFull(); // off
          },

          _stopAllPlayback() {
            clearInterval(this.simInterval); this.simInterval = null;
            clearInterval(this.replayInterval); this.replayInterval = null;
            this.replayPlaying = false;
          },

          _resetToFull() {
            // Reload full historical candles for current tf + chart type
            this._loadCandles(this.activeTf);
            const raw = this._rawCandles(this.activeTf);
            if (raw.length) this.lastPrice = raw[raw.length - 1].c;
          },

          // ── Simulation ────────────────────────────────────────
          _startSim() {
            const tfSec = TF_SECONDS[this.activeTf] || 3600;
            const raw = this._rawCandles(this.activeTf);
            if (raw.length) this.simLastCandle = { ...raw[raw.length - 1] };
            this.simInterval = setInterval(() => {
              const prev = this.simLastCandle;
              const vol   = prev.c * (0.005 + simRand() * 0.006);
              const body  = (simRand() - 0.49) * vol;
              const open  = prev.c;
              const close = Math.max(1000, open + body);
              const wick  = simRand() * Math.abs(body) * 0.6;
              const candle = {
                time: prev.time + tfSec,
                o: Math.round(open*100)/100,
                h: Math.round((Math.max(open,close)+wick)*100)/100,
                l: Math.round(Math.max(1000, Math.min(open,close)-wick*simRand())*100)/100,
                c: Math.round(close*100)/100,
                v: Math.round(Math.max(10, 200+simRand()*400)*10)/10,
              };
              this.chart.addCandle(candle);
              this._onNewClose(candle.c);
              this.simLastCandle = candle;
            }, 1500);
          },

          // ── Replay ────────────────────────────────────────────
          _startReplay() {
            const raw = this._rawCandles(this.activeTf);
            // Apply HA/Renko transform once for replay base
            let base = raw;
            if (this.chartType === "ha")    base = toHeikinAshi(raw);
            else if (this.chartType === "renko") base = toRenko(raw);
            this.replayBaseCandles = base;
            this.replayTotal = base.length;
            // Start at ~30% of data so user sees something animated
            const start = Math.max(2, Math.floor(base.length * 0.3));
            this.replayPos = start;
            this.chart.setCandles(base.slice(0, start));
            this.replayPlaying = true;
            this._scheduleReplayTick();
          },

          _scheduleReplayTick() {
            clearInterval(this.replayInterval);
            const intervalMs = Math.max(50, 800 / this.replaySpeed);
            this.replayInterval = setInterval(() => {
              if (!this.replayPlaying) return;
              if (this.replayPos >= this.replayTotal) {
                this.replayPlaying = false;
                clearInterval(this.replayInterval);
                return;
              }
              const c = this.replayBaseCandles[this.replayPos];
              this.chart.addCandle(c);
              this._onNewClose(c.c);
              this.replayPos += 1;
            }, intervalMs);
          },

          replayToggle() {
            if (this.mode !== "replay") return;
            this.replayPlaying = !this.replayPlaying;
            if (this.replayPlaying) this._scheduleReplayTick();
          },

          replayStep() {
            if (this.mode !== "replay") return;
            if (this.replayPos >= this.replayTotal) return;
            const c = this.replayBaseCandles[this.replayPos];
            this.chart.addCandle(c);
            this._onNewClose(c.c);
            this.replayPos += 1;
          },

          replaySeek(pos) {
            if (this.mode !== "replay") return;
            const idx = Math.max(0, Math.min(this.replayTotal, Math.floor(pos)));
            this.replayPos = idx;
            // Rebuild chart from start
            this.chart.setCandles(this.replayBaseCandles.slice(0, idx));
            if (idx > 0) this.lastPrice = this.replayBaseCandles[idx - 1].c;
          },

          replayRestart() {
            if (this.mode === "replay" && this.replayPlaying) this._scheduleReplayTick();
          },

          // ── Alerts ────────────────────────────────────────────
          addAlertAt(price) {
            const current = this.lastPrice ?? price;
            const dir = price >= current ? "above" : "below";
            const id = ++this._alertId;
            this.alerts.push({ id, price, dir, triggered: false });
            // Draw horizontal line so user sees it
            const lineId = `alert-${id}`;
            this.chart?.chart?.createHorizontalLine(lineId, price);
          },

          removeAlert(idx) {
            const a = this.alerts[idx];
            if (!a) return;
            try { this.chart?.chart?.removeTool(`alert-${a.id}`); } catch (_) {}
            this.alerts.splice(idx, 1);
          },

          _checkAlerts(close) {
            for (const a of this.alerts) {
              if (a.triggered) continue;
              if ((a.dir === "above" && close >= a.price) ||
                  (a.dir === "below" && close <= a.price)) {
                a.triggered = true;
                this._fireAlert(a);
              }
            }
          },

          _fireAlert(a) {
            this.alertFlash = true;
            setTimeout(() => { this.alertFlash = false; }, 800);
            if ("Notification" in window && Notification.permission === "granted") {
              new Notification("LoomChart alert", {
                body: `Price ${a.dir} ${a.price.toFixed(2)}`,
              });
            }
          },

          _onNewClose(close) {
            const prev = this.lastPrice;
            this.lastPrice = close;
            this.priceDir = prev == null ? "" : (close > prev ? "up" : close < prev ? "dn" : "");
            this._checkAlerts(close);
            this._checkStrategySignal();
          },

          // ── Indicator alert: SMA crossover on last candle ─────
          _checkStrategySignal() {
            if (!this.showStrategy) return;
            const candles = this.chart?.getCachedCandles() || [];
            if (candles.length < 21) return;
            const fastAt = (idx) => {
              if (idx < 4) return null;
              let s = 0;
              for (let i = idx - 4; i <= idx; i++) s += candles[i].c;
              return s / 5;
            };
            const slowAt = (idx) => {
              if (idx < 19) return null;
              let s = 0;
              for (let i = idx - 19; i <= idx; i++) s += candles[i].c;
              return s / 20;
            };
            const n = candles.length - 1;
            const fNow = fastAt(n), sNow = slowAt(n);
            const fPrev = fastAt(n - 1), sPrev = slowAt(n - 1);
            if (fNow == null || sNow == null || fPrev == null || sPrev == null) return;
            const prevD = fPrev - sPrev;
            const curD  = fNow - sNow;
            let kind = null;
            if (prevD <= 0 && curD > 0) kind = "buy";
            else if (prevD >= 0 && curD < 0) kind = "sell";
            if (!kind) return;
            this._fireSignal(kind, candles[n].c);
          },

          _fireSignal(kind, price) {
            this.alertFlash = true;
            setTimeout(() => { this.alertFlash = false; }, 800);
            if ("Notification" in window && Notification.permission === "granted") {
              new Notification(`LoomChart ${kind.toUpperCase()} signal`, {
                body: `SMA crossover at ${price.toFixed(2)}`,
              });
            }
          },

          // ── Layouts ───────────────────────────────────────────
          _readLayouts() {
            try {
              return JSON.parse(localStorage.getItem("loomchart-demo-layouts") || "[]");
            } catch (_) { return []; }
          },

          _writeLayouts() {
            try { localStorage.setItem("loomchart-demo-layouts", JSON.stringify(this.savedLayouts)); }
            catch (_) {}
          },

          saveLayout() {
            const name = (this.layoutNameInput || "").trim() || `Layout ${this.savedLayouts.length + 1}`;
            let wasmState = "";
            try { wasmState = this.chart?.chart?.exportState() || ""; } catch (_) {}
            const layout = {
              name,
              ts: Date.now(),
              tf: this.activeTf,
              chartType: this.chartType,
              logScale: this.logScale,
              axisLocked: this.axisLocked,
              darkMode: this.darkMode,
              wasmState,
            };
            this.savedLayouts.push(layout);
            this._writeLayouts();
            this.layoutNameInput = "";
          },

          loadLayout(idx) {
            const lo = this.savedLayouts[idx];
            if (!lo) return;
            // Stop any playback first
            this.setMode("off");
            // Apply timeframe (rebuilds chart instance)
            if (lo.tf !== this.activeTf) {
              this.activeTf = lo.tf;
              this.chart.switchTimeframe(lo.tf);
            }
            this.chartType = lo.chartType;
            this.logScale = !!lo.logScale;
            this.axisLocked = !!lo.axisLocked;
            this.darkMode = !!lo.darkMode;
            document.body.classList.toggle("dark", this.darkMode);
            document.body.classList.toggle("light", !this.darkMode);
            this.chart.setTheme(this.darkMode);
            this.chart.setLogScale(this.logScale);
            this.chart.setPriceLocked(this.axisLocked);
            const wasmStyle = (lo.chartType === "ha" || lo.chartType === "renko") ? "candlestick" : lo.chartType;
            this.chart.setCandleStyle(wasmStyle);
            // Import full WASM state if available
            if (lo.wasmState) {
              try { this.chart.chart?.importState(lo.wasmState); } catch (e) { console.warn("Import failed:", e); }
            } else {
              this._loadCandles(lo.tf);
            }
            this.layoutsOpen = false;
          },

          deleteLayout(idx) {
            this.savedLayouts.splice(idx, 1);
            this._writeLayouts();
          },

          // ── Symbol search & watchlist ─────────────────────────
          filteredSymbols() {
            const q = (this.symbolQuery || "").trim().toLowerCase();
            if (!q) return MOCK_SYMBOLS;
            return MOCK_SYMBOLS.filter(s =>
              s.sym.toLowerCase().includes(q) || s.name.toLowerCase().includes(q)
            );
          },

          selectSymbol(s) {
            this.selectedSymbol = s.sym;
            this.symbolsOpen = false;
          },

          _updateOhlcv(info) {
            if (!info) { this.ohlcv.open = null; return; }
            const v = typeof info === "string" ? JSON.parse(info) : info;
            const d = v?.ohlcv ?? v;
            if (!d) return;
            this.ohlcv = {
              open:   d.open  ?? d.o,
              high:   d.high  ?? d.h,
              low:    d.low   ?? d.l,
              close:  d.close ?? d.c,
              volume: d.volume ?? d.v,
              dir: (d.close ?? d.c) >= (d.open ?? d.o) ? "ohlcv-up" : "ohlcv-down",
            };
          },

          fmt(v) {
            if (v == null) return "—";
            return Number(v).toLocaleString("en-US", { minimumFractionDigits:2, maximumFractionDigits:2 });
          },
          fmtVol(v) {
            if (v == null) return "—";
            return v >= 1000 ? (v/1000).toFixed(1)+"K" : Number(v).toFixed(0);
          },
        }));
      });
    </script>
  </body>
</html>
