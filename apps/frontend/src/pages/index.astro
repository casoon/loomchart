---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';
import LoadingSpinner from '../components/LoadingSpinner.astro';
import ErrorDisplay from '../components/ErrorDisplay.astro';
import IndicatorSelector from '../components/IndicatorSelector.astro';
import PanelManager from '../components/PanelManager.astro';
import LayoutManager from '../components/LayoutManager.astro';
import LayoutPresets from '../components/LayoutPresets.astro';
import DrawingToolbar from '../components/DrawingToolbar.astro';
import ChartAxis from '../components/ChartAxis.astro';
import ChartPan from '../components/ChartPan.astro';
import PanelContainer from '../components/PanelContainer.astro';
import PanelContextMenu from '../components/PanelContextMenu.astro';
import Toast from '../components/Toast.astro';
import CacheManager from '../components/CacheManager.astro';
import ChartTooltip from '../components/ChartTooltip.astro';
import CandleCountdown from '../components/CandleCountdown.astro';
import StateManager from '../components/StateManager.astro';
import EntropyOverlay from '../components/EntropyOverlay.astro';
import RegimeIndicator from '../components/RegimeIndicator.astro';
import PriceAlerts from '../components/PriceAlerts.astro';
import IndicatorAlerts from '../components/IndicatorAlerts.astro';
import Watchlist from '../components/Watchlist.astro';
import NewsOverlay from '../components/NewsOverlay.astro';
import SymbolSearch from '../components/SymbolSearch.astro';
import PluginManager from '../components/PluginManager.astro';
import AlertManager from '../components/AlertManager.astro';
import FootprintOverlay from '../components/FootprintOverlay.astro';
import MultiChartGrid from '../components/MultiChartGrid.astro';
import SymbolCompare from '../components/SymbolCompare.astro';
import VolumeProfile from '../components/VolumeProfile.astro';
---

<Layout title="Loom - Trading UI">
  <div
    x-data="tradingApp()"
    x-init="init()"
    style="display:flex;height:100vh;width:100%;background:var(--bg)"
  >
    <Sidebar />

    <div style="display:flex;flex-direction:column;flex:1;overflow:hidden;min-width:0">
      <TopBar />

      <!-- Chart area -->
      <main style="flex:1;position:relative;overflow:hidden">
        <!-- Loading Overlay -->
        <template x-if="loading">
          <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(11,15,23,0.8);z-index:10">
            <LoadingSpinner size="lg" message="Loading..." />
          </div>
        </template>

        <!-- Error Overlay -->
        <template x-if="error">
          <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(11,15,23,0.8);z-index:10">
            <ErrorDisplay title="Error" x-bind:message="error" />
          </div>
        </template>

        <div id="chart-main-container" style="width:100%;height:100%;position:relative">
          <div id="main-chart" style="width:100%;height:100%"></div>
          <ChartAxis />
          <PanelContainer />
          <DrawingToolbar />
          <ChartTooltip />
          <EntropyOverlay />
          <RegimeIndicator />
          <PriceAlerts />
          <ChartPan />
        </div>

        <!-- Status bar: OHLCV at bottom of chart -->
        <div id="chart-status-bar">
          <template x-if="lastCandle">
            <div class="status-ohlcv">
              <span class="status-label">O</span><span x-text="lastCandle?.o?.toFixed(2)"></span>
              <span class="status-label">H</span><span class="status-green" x-text="lastCandle?.h?.toFixed(2)"></span>
              <span class="status-label">L</span><span class="status-red" x-text="lastCandle?.l?.toFixed(2)"></span>
              <span class="status-label">C</span>
              <span :class="lastCandle?.c >= lastCandle?.o ? 'status-green' : 'status-red'" x-text="lastCandle?.c?.toFixed(2)"></span>
              <span class="status-label">Vol</span>
              <span x-text="lastCandle?.v ? (lastCandle.v/1000).toFixed(1)+'k' : '—'"></span>
              <span class="status-sep"></span>
              <span class="status-label">Candles</span>
              <span x-text="candleCount || 0"></span>
            </div>
          </template>
          <!-- Live/test data buttons in status bar -->
          <div class="status-actions" x-data>
            <button @click="loadTestData()" :disabled="loading" class="status-btn">
              <span x-show="!loading">Test Data</span><span x-show="loading">...</span>
            </button>
            <button @click="fetchCandles()" :disabled="loading" class="status-btn status-btn--primary">
              <span x-show="!loading">Live</span><span x-show="loading">...</span>
            </button>
          </div>
        </div>
      </main>
    </div>

    <!-- Modals & Overlays -->
    <IndicatorAlerts />
    <IndicatorSelector />
    <Watchlist />
    <NewsOverlay />
    <PanelManager />
    <LayoutManager />
    <LayoutPresets />
    <CacheManager />
    <PanelContextMenu />
    <Toast />
    <CandleCountdown />
    <StateManager />
    <SymbolSearch />
    <PluginManager />
    <AlertManager />
    <FootprintOverlay />
    <MultiChartGrid />
    <SymbolCompare />
    <VolumeProfile />
  </div>

  <style is:global>
    #chart-status-bar {
      position: absolute; bottom: 0; left: 0; right: 0;
      height: 28px; background: var(--surface); border-top: 1px solid var(--border);
      display: flex; align-items: center; padding: 0 10px; gap: 0; z-index: 10;
      font-size: 11px; font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
    }
    .status-ohlcv { display: flex; align-items: center; gap: 8px; flex: 1; }
    .status-label { color: var(--muted); }
    .status-green { color: var(--green); }
    .status-red { color: var(--red); }
    .status-sep { width: 1px; height: 14px; background: var(--border); margin: 0 4px; }
    .status-actions { display: flex; gap: 6px; margin-left: auto; }
    .status-btn {
      padding: 2px 10px; border-radius: 3px; font-size: 11px; font-weight: 500;
      color: var(--muted); background: transparent; border: 1px solid var(--border);
      cursor: pointer; transition: all 0.15s;
    }
    .status-btn:hover { color: var(--text); border-color: var(--text); }
    .status-btn--primary { background: var(--accent); color: #fff; border-color: var(--accent); }
    .status-btn--primary:hover { background: #5ea8ff; }
  </style>

  <script is:inline>
    console.log('[Index] Script running');
  </script>

  <script>
    import { initTradingApp } from '../lib/app-rust';
    import '../lib/toast'; // Initialize toast system
    import '../lib/loading-state'; // Initialize loading state
    import Alpine from 'alpinejs';

    console.log('[Index] Module script running - Rust Chart Engine');
    Alpine.data('tradingApp', initTradingApp);
    console.log('[Index] Registered tradingApp with Rust Chart');

    window.addEventListener('topbar-set-timeframe', e => {
      const app = Alpine.$data(document.querySelector('[x-data]'));
      if (app && e.detail?.tf) app.setTimeframe(e.detail.tf);
    });
    window.addEventListener('topbar-set-source', e => {
      const app = Alpine.$data(document.querySelector('[x-data]'));
      if (app && e.detail?.source) { app.selectedSource = e.detail.source; }
    });
  </script>
</Layout>
