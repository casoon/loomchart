---
// Sidebar.astro — Drawing tools + chart navigation
---

<aside id="loom-sidebar">
  <!-- Logo mark (top) -->
  <div class="sb-logo">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
      <path d="M3 3v16a2 2 0 002 2h16" stroke="#4e9cff" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M7 14l4-5 4 4 4-6" stroke="#4e9cff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <!-- Drawing tool buttons -->
  <div class="sb-tools">
    <div class="sb-section">
      <button class="sb-btn active" title="Cursor (V)" data-tool="cursor" onclick="setSidebarTool(this)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 3l14 9-7 1-4 7z"/></svg>
      </button>
    </div>

    <div class="sb-divider"></div>

    <div class="sb-section">
      <button class="sb-btn" title="Trend Line (T)" data-tool="trendline" onclick="setSidebarTool(this)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" y1="20" x2="20" y2="4"/><circle cx="4" cy="20" r="1.5" fill="currentColor"/><circle cx="20" cy="4" r="1.5" fill="currentColor"/>
        </svg>
      </button>

      <button class="sb-btn" title="Horizontal Line (H)" data-tool="hline" onclick="setSidebarTool(this)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12" stroke-dasharray="3 2"/>
        </svg>
      </button>

      <button class="sb-btn" title="Vertical Line (L)" data-tool="vline" onclick="setSidebarTool(this)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="3" x2="12" y2="21" stroke-dasharray="3 2"/>
        </svg>
      </button>

      <button class="sb-btn" title="Rectangle (R)" data-tool="rect" onclick="setSidebarTool(this)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="4" y="6" width="16" height="12" rx="1"/>
        </svg>
      </button>

      <button class="sb-btn" title="Fibonacci (F)" data-tool="fib" onclick="setSidebarTool(this)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" y1="5" x2="20" y2="5"/><line x1="4" y1="10" x2="20" y2="10"/>
          <line x1="4" y1="16" x2="20" y2="16"/><line x1="4" y1="20" x2="20" y2="20"/>
        </svg>
      </button>
    </div>

    <div class="sb-divider"></div>

    <div class="sb-section">
      <button class="sb-btn sb-btn--danger" title="Delete selected" onclick="window.__loomChart?.clearTools()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6m5 0V4h4v2"/>
        </svg>
      </button>
    </div>
  </div>
</aside>

<style>
#loom-sidebar {
  width: 44px;
  background: var(--surface);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  z-index: 50;
  position: relative;
}
.sb-logo {
  width: 44px; height: 44px;
  display: flex; align-items: center; justify-content: center;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.sb-tools { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 8px 0; width: 100%; }
.sb-section { display: flex; flex-direction: column; align-items: center; gap: 2px; width: 100%; padding: 0 4px; }
.sb-divider { width: 28px; height: 1px; background: var(--border); margin: 4px 0; }
.sb-btn {
  width: 36px; height: 36px; border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  color: var(--muted); background: transparent; border: none; cursor: pointer;
  transition: color 0.15s, background 0.15s;
  position: relative;
}
.sb-btn:hover { color: var(--text); background: rgba(255,255,255,0.08); }
.sb-btn.active { color: var(--accent); background: var(--accent-dim); }
.sb-btn--danger { color: var(--red) !important; opacity: 0.6; }
.sb-btn--danger:hover { opacity: 1; background: rgba(248,81,73,0.15) !important; }
</style>

<script is:inline>
function setSidebarTool(btn) {
  document.querySelectorAll('.sb-btn[data-tool]').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  window.dispatchEvent(new CustomEvent('drawing-tool-changed', { detail: { tool: btn.dataset.tool } }));
}
</script>
