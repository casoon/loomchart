---
/**
 * Volume Profile Overlays — VPVR (#18) & VPSV (#19)
 *
 * VPVR: Horizontal volume histogram for the visible price range, rendered
 *       as horizontal bars on the right-hand side of the chart (80px wide).
 *       Point of Control (POC) highlighted in orange; Value Area (70 % of
 *       total volume) in a brighter teal.
 *
 * VPSV: Same algorithm but computed per UTC-day session and rendered at
 *       reduced opacity. Multiple sessions can overlap.
 *
 * Both modes are independent toggles and can be active simultaneously.
 *
 * Canvas is absolutely positioned over #chart-main-container with
 * pointer-events:none — same pattern as SymbolCompare.
 */
---

<!-- Overlay canvas — no UI panel needed, just the canvas -->
<canvas
  id="vpvr-canvas"
  style="pointer-events:none; position:absolute; inset:0; width:100%; height:100%; z-index:6;"
></canvas>

<script is:inline>
(function () {
  /* -------------------------------------------------------------------------
   * Constants
   * ----------------------------------------------------------------------- */
  const BUCKET_COUNT    = 50;
  const BAR_WIDTH_PX    = 80;   // right-side area reserved for profiles
  const VALUE_AREA_PCT  = 0.70; // 70 % of total volume = value area

  // VPVR colours
  const VPVR_NORMAL     = 'rgba(0, 180, 216, 0.4)';
  const VPVR_VA         = 'rgba(0, 180, 216, 0.65)';
  const VPVR_POC        = 'rgba(255, 150, 0, 0.85)';

  // VPSV colours
  const VPSV_NORMAL     = 'rgba(124, 58, 237, 0.3)';
  const VPSV_VA         = 'rgba(124, 58, 237, 0.50)';
  const VPSV_POC        = 'rgba(220, 130, 255, 0.75)';

  /* -------------------------------------------------------------------------
   * State
   * ----------------------------------------------------------------------- */
  let vpvrActive = false;
  let vpsvActive = false;
  let allCandles  = [];   // full candle array from WASM
  let viewport    = null; // latest viewport info from WASM

  /* -------------------------------------------------------------------------
   * Canvas setup
   * ----------------------------------------------------------------------- */
  const canvas = document.getElementById('vpvr-canvas');
  const ctx    = canvas ? canvas.getContext('2d') : null;

  function resizeCanvas() {
    const parent = document.getElementById('chart-main-container');
    if (!canvas || !parent) return;
    const rect = parent.getBoundingClientRect();
    canvas.width  = rect.width;
    canvas.height = rect.height;
    draw();
  }

  /* -------------------------------------------------------------------------
   * Volume-profile algorithm
   *   candles : [{time, o, h, l, c, v}]
   *   priceMin, priceMax : visible price range
   *   returns  : { buckets: Float64Array, pocIndex: number,
   *               vaLow: number, vaHigh: number }
   * ----------------------------------------------------------------------- */
  function buildProfile(candles, priceMin, priceMax) {
    const range = priceMax - priceMin;
    if (range <= 0 || candles.length === 0) return null;

    const buckets = new Float64Array(BUCKET_COUNT);
    const step    = range / BUCKET_COUNT;

    for (const c of candles) {
      const idx = Math.min(
        BUCKET_COUNT - 1,
        Math.max(0, Math.floor((c.c - priceMin) / step))
      );
      buckets[idx] += c.v;
    }

    // POC = index with maximum volume
    let pocIndex = 0;
    for (let i = 1; i < BUCKET_COUNT; i++) {
      if (buckets[i] > buckets[pocIndex]) pocIndex = i;
    }

    // Value area: expand from POC outward until 70 % of total volume is covered
    const totalVolume = buckets.reduce((a, b) => a + b, 0);
    const vaTarget    = totalVolume * VALUE_AREA_PCT;

    let lo = pocIndex, hi = pocIndex;
    let accumulated = buckets[pocIndex];

    while (accumulated < vaTarget && (lo > 0 || hi < BUCKET_COUNT - 1)) {
      const addLo = lo > 0               ? buckets[lo - 1] : 0;
      const addHi = hi < BUCKET_COUNT - 1 ? buckets[hi + 1] : 0;

      if (addLo >= addHi) { lo--; accumulated += addLo; }
      else                { hi++; accumulated += addHi; }
    }

    return { buckets, pocIndex, vaLow: lo, vaHigh: hi };
  }

  /* -------------------------------------------------------------------------
   * Draw one profile on the canvas
   *   profile    : result of buildProfile
   *   priceMin/Max : visible range
   *   canvasH    : canvas height in px
   *   canvasW    : canvas width  in px
   *   colors     : { normal, va, poc }
   * ----------------------------------------------------------------------- */
  function drawProfile(profile, priceMin, priceMax, canvasH, canvasW, colors) {
    if (!profile || !ctx) return;

    const { buckets, pocIndex, vaLow, vaHigh } = profile;
    const maxVol  = Math.max(...buckets);
    if (maxVol === 0) return;

    const step     = (priceMax - priceMin) / BUCKET_COUNT;
    const bucketPx = canvasH / BUCKET_COUNT;
    const xRight   = canvasW;          // right edge of canvas

    for (let i = 0; i < BUCKET_COUNT; i++) {
      if (buckets[i] === 0) continue;

      const barW = (buckets[i] / maxVol) * BAR_WIDTH_PX;
      const priceAtBucket = priceMin + i * step;

      // Y position: price increases upward on screen
      const y = canvasH - ((priceAtBucket - priceMin) / (priceMax - priceMin)) * canvasH;

      // Colour selection
      let color;
      if (i === pocIndex)             color = colors.poc;
      else if (i >= vaLow && i <= vaHigh) color = colors.va;
      else                            color = colors.normal;

      ctx.fillStyle = color;
      ctx.fillRect(xRight - barW, y - bucketPx, barW, bucketPx);
    }
  }

  /* -------------------------------------------------------------------------
   * Main draw function
   * ----------------------------------------------------------------------- */
  function draw() {
    if (!ctx || !canvas) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    if (!vpvrActive && !vpsvActive) return;

    // Pull fresh data if WASM is available
    if (window.__loomChart) {
      try {
        allCandles = JSON.parse(window.__loomChart.getCandles() || '[]');
        viewport   = JSON.parse(window.__loomChart.getViewportInfo() || 'null');
      } catch (_) { /* ignore parse errors */ }
    }

    if (!viewport || allCandles.length === 0) return;

    const { time, price, dimensions } = viewport;
    if (!time || !price || !dimensions) return;

    const { start: tStart, end: tEnd } = time;
    const { min: pMin, max: pMax }     = price;
    const { width: cW, height: cH }    = dimensions;

    // Use canvas pixel dimensions, fallback to viewport dimensions
    const canvasW = canvas.width  || cW;
    const canvasH = canvas.height || cH;

    // Filter to visible candles
    const visible = allCandles.filter(c => c.time >= tStart && c.time <= tEnd);

    /* ------ VPVR --------------------------------------------------------- */
    if (vpvrActive && visible.length > 0) {
      const profile = buildProfile(visible, pMin, pMax);
      drawProfile(profile, pMin, pMax, canvasH, canvasW, {
        normal: VPVR_NORMAL,
        va:     VPVR_VA,
        poc:    VPVR_POC,
      });
    }

    /* ------ VPSV --------------------------------------------------------- */
    if (vpsvActive && visible.length > 0) {
      // Group candles by UTC day (floor to midnight)
      const sessions = new Map();
      for (const c of visible) {
        const day = Math.floor(c.time / 86400) * 86400;
        if (!sessions.has(day)) sessions.set(day, []);
        sessions.get(day).push(c);
      }

      for (const [, sessionCandles] of sessions) {
        if (sessionCandles.length === 0) continue;

        // Compute per-session price range for better resolution
        let sMin = Infinity, sMax = -Infinity;
        for (const c of sessionCandles) {
          if (c.l < sMin) sMin = c.l;
          if (c.h > sMax) sMax = c.h;
        }
        // Clamp to visible viewport
        sMin = Math.max(sMin, pMin);
        sMax = Math.min(sMax, pMax);

        const profile = buildProfile(sessionCandles, sMin, sMax);
        // Draw session profile mapped to the full canvas height via pMin/pMax
        drawProfile(profile, sMin, sMax, canvasH, canvasW, {
          normal: VPSV_NORMAL,
          va:     VPSV_VA,
          poc:    VPSV_POC,
        });
      }
    }
  }

  /* -------------------------------------------------------------------------
   * Button state helpers (aria-pressed)
   * ----------------------------------------------------------------------- */
  function syncButtons() {
    const btnVpvr = document.getElementById('vpvr-toggle-btn');
    const btnVpsv = document.getElementById('vpsv-toggle-btn');
    if (btnVpvr) btnVpvr.setAttribute('aria-pressed', String(vpvrActive));
    if (btnVpsv) btnVpsv.setAttribute('aria-pressed', String(vpsvActive));

    if (canvas) canvas.style.display = (vpvrActive || vpsvActive) ? '' : 'none';
  }

  /* -------------------------------------------------------------------------
   * Event wiring
   * ----------------------------------------------------------------------- */
  document.addEventListener('DOMContentLoaded', () => {
    // Toolbar buttons
    document.getElementById('vpvr-toggle-btn')?.addEventListener('click', () => {
      vpvrActive = !vpvrActive;
      syncButtons();
      draw();
    });

    document.getElementById('vpsv-toggle-btn')?.addEventListener('click', () => {
      vpsvActive = !vpsvActive;
      syncButtons();
      draw();
    });

    // External event triggers (alternative toggle)
    window.addEventListener('toggle-vpvr', () => {
      vpvrActive = !vpvrActive;
      syncButtons();
      draw();
    });

    window.addEventListener('toggle-vpsv', () => {
      vpsvActive = !vpsvActive;
      syncButtons();
      draw();
    });

    // Redraw on viewport or candle changes
    window.addEventListener('chart-viewport-changed', (e) => {
      if (e.detail) viewport = e.detail;
      draw();
    });

    window.addEventListener('chart-candles-updated', (e) => {
      if (e.detail?.candles) allCandles = e.detail.candles;
      draw();
    });

    // Keep canvas sized to the chart container
    new ResizeObserver(resizeCanvas).observe(
      document.getElementById('chart-main-container') || document.body
    );

    // Initial sizing
    resizeCanvas();
    syncButtons();
  });
})();
</script>
