---
/**
 * Price Alerts (#28)
 *
 * Visual price alert lines on the chart canvas + IndexedDB persistence.
 * DB: loom-alerts / store: price-alerts
 * Toggle via `toggle-price-alerts` window event.
 */
---

<!-- Canvas overlay (absolutely positioned over chart, pointer-events none) -->
<canvas
  id="price-alerts-canvas"
  style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:50;"
></canvas>

<!-- UI Panel -->
<div id="price-alerts-panel" class="pa-panel hidden">
  <div class="pa-header">
    <h3>Price Alerts</h3>
    <button id="pa-close" class="pa-close-btn">×</button>
  </div>

  <!-- Add new alert form -->
  <details class="pa-create-section" open>
    <summary class="pa-section-title">New Alert</summary>
    <div class="pa-form">
      <div class="pa-field">
        <label>Symbol</label>
        <input id="pa-symbol" type="text" placeholder="BTCUSD" />
      </div>
      <div class="pa-field">
        <label>Condition</label>
        <select id="pa-condition">
          <option value="above">Price above ▲</option>
          <option value="below">Price below ▼</option>
        </select>
      </div>
      <div class="pa-field">
        <label>Price</label>
        <input id="pa-price" type="number" placeholder="e.g. 45000" step="any" />
      </div>
      <div class="pa-field">
        <label>Label (optional)</label>
        <input id="pa-label" type="text" placeholder="My target" />
      </div>
      <div style="display:flex;gap:6px;">
        <button id="pa-add-btn" class="pa-btn-primary" style="flex:1;">Add Alert</button>
        <button id="pa-add-from-chart-btn" class="pa-btn-secondary" title="Click Y-axis to set price">From Chart</button>
      </div>
    </div>
  </details>

  <!-- Alert list -->
  <div class="pa-section-title" style="margin-top:8px;">Active Alerts</div>
  <div id="pa-list" class="pa-list">
    <div class="pa-empty">No price alerts</div>
  </div>
</div>

<style>
  .pa-panel {
    position: fixed;
    right: 20px;
    top: 120px;
    width: 300px;
    background: rgba(17, 24, 39, 0.98);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 8px;
    z-index: 2100;
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    max-height: calc(100vh - 140px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .pa-panel.hidden { display: none; }

  .pa-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 14px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    background: rgba(0,0,0,0.3);
    border-radius: 8px 8px 0 0;
    flex-shrink: 0;
  }
  .pa-header h3 {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }
  .pa-close-btn {
    background: none;
    border: none;
    color: rgba(255,255,255,0.4);
    font-size: 18px;
    cursor: pointer;
    padding: 0 2px;
    line-height: 1;
  }
  .pa-close-btn:hover { color: #fff; }

  .pa-create-section {
    border-bottom: 1px solid rgba(255,255,255,0.08);
    flex-shrink: 0;
  }
  .pa-section-title {
    font-size: 10px;
    font-weight: 600;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 8px 12px 4px;
    cursor: pointer;
    user-select: none;
  }
  summary.pa-section-title { list-style: none; }
  summary.pa-section-title::marker { display: none; }

  .pa-form {
    padding: 8px 12px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pa-field {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .pa-field label {
    font-size: 10px;
    color: rgba(255,255,255,0.4);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .pa-field input,
  .pa-field select {
    background: rgba(0,0,0,0.4);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 4px;
    color: #e5e7eb;
    font-size: 12px;
    padding: 6px 8px;
    outline: none;
    transition: border-color 0.15s;
  }
  .pa-field input:focus,
  .pa-field select:focus { border-color: rgba(59,130,246,0.5); }

  .pa-btn-primary {
    background: #3b82f6;
    border: none;
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    padding: 7px 14px;
    border-radius: 5px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .pa-btn-primary:hover { background: #2563eb; }

  .pa-btn-secondary {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.55);
    font-size: 11px;
    padding: 5px 10px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .pa-btn-secondary:hover { background: rgba(255,255,255,0.12); color: #fff; }
  .pa-btn-secondary.active { background: rgba(251,191,36,0.2); border-color: rgba(251,191,36,0.4); color: #fbbf24; }

  .pa-list {
    overflow-y: auto;
    flex: 1;
    padding: 4px 0 8px;
  }
  .pa-alert-item {
    padding: 8px 12px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pa-alert-info { flex: 1; min-width: 0; }
  .pa-alert-symbol {
    font-size: 12px;
    font-weight: 600;
    color: #e5e7eb;
  }
  .pa-alert-desc {
    font-size: 10px;
    color: rgba(255,255,255,0.4);
    margin-top: 2px;
  }
  .pa-delete-btn {
    background: none;
    border: none;
    color: rgba(248,113,113,0.4);
    font-size: 14px;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    flex-shrink: 0;
  }
  .pa-delete-btn:hover { color: #f87171; }
  .pa-empty {
    text-align: center;
    color: rgba(255,255,255,0.3);
    font-size: 12px;
    padding: 20px;
  }
</style>

<script is:inline>
(function () {
  const DB_NAME = 'loom-alerts';
  const STORE   = 'price-alerts';

  // -------------------------------------------------------------------------
  // IndexedDB helpers
  // -------------------------------------------------------------------------
  function openDB() {
    return new Promise((resolve, reject) => {
      const req = indexedDB.open(DB_NAME, 1);
      req.onupgradeneeded = (e) => {
        const db = e.target.result;
        if (!db.objectStoreNames.contains(STORE)) {
          db.createObjectStore(STORE, { keyPath: 'id' });
        }
        if (!db.objectStoreNames.contains('indicator-alerts')) {
          db.createObjectStore('indicator-alerts', { keyPath: 'id' });
        }
      };
      req.onsuccess = (e) => resolve(e.target.result);
      req.onerror   = (e) => reject(e.target.error);
    });
  }

  async function dbGetAll() {
    const db = await openDB();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE, 'readonly');
      const req = tx.objectStore(STORE).getAll();
      req.onsuccess = () => resolve(req.result);
      req.onerror   = () => reject(req.error);
    });
  }

  async function dbPut(alert) {
    const db = await openDB();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE, 'readwrite');
      const req = tx.objectStore(STORE).put(alert);
      req.onsuccess = () => resolve();
      req.onerror   = () => reject(req.error);
    });
  }

  async function dbDelete(id) {
    const db = await openDB();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE, 'readwrite');
      const req = tx.objectStore(STORE).delete(id);
      req.onsuccess = () => resolve();
      req.onerror   = () => reject(req.error);
    });
  }

  // -------------------------------------------------------------------------
  // Canvas overlay
  // -------------------------------------------------------------------------
  function getCanvas() { return document.getElementById('price-alerts-canvas'); }

  function resizeCanvas() {
    const canvas = getCanvas();
    if (!canvas) return;
    const container = document.getElementById('chart-main-container') || document.body;
    canvas.width  = container.clientWidth;
    canvas.height = container.clientHeight;
  }

  async function redrawAlerts() {
    const canvas = getCanvas();
    if (!canvas) return;
    resizeCanvas();
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const symbol = (window.__loomSymbol || 'BTCUSD').toUpperCase();
    let viewportInfo = null;
    try {
      viewportInfo = window.__loomChart?.getViewportInfo?.();
    } catch (_) {}

    if (!viewportInfo) return;

    const { priceMin, priceMax } = viewportInfo;
    const height = canvas.height;
    const width  = canvas.width;

    const alerts = await dbGetAll();
    const active  = alerts.filter(a => a.active && a.symbol.toUpperCase() === symbol);

    ctx.save();
    ctx.setLineDash([6, 4]);
    ctx.lineWidth = 1.5;
    ctx.font = '11px monospace';

    for (const alert of active) {
      const priceRange = priceMax - priceMin;
      if (priceRange === 0) continue;
      const y = height - ((alert.price - priceMin) / priceRange) * height;
      if (y < 0 || y > height) continue;

      const isAbove = alert.condition === 'above';
      ctx.strokeStyle = isAbove ? '#22c55e' : '#ef4444';
      ctx.fillStyle   = isAbove ? '#22c55e' : '#ef4444';

      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(width - 90, y);
      ctx.stroke();

      const arrow = isAbove ? '▲' : '▼';
      const labelText = `${arrow} ${alert.label || alert.price.toFixed(2)}`;
      ctx.fillStyle = isAbove ? '#22c55e' : '#ef4444';
      ctx.textAlign = 'right';
      ctx.textBaseline = 'middle';
      ctx.fillText(labelText, width - 4, y);
    }

    ctx.restore();
  }

  // -------------------------------------------------------------------------
  // Alert trigger check
  // -------------------------------------------------------------------------
  let prevCloses = {};

  async function checkAlerts(candle) {
    if (!candle) return;
    const close  = candle.c;
    const symbol = (window.__loomSymbol || 'BTCUSD').toUpperCase();
    const alerts = await dbGetAll();

    for (const alert of alerts) {
      if (!alert.active) continue;
      if (alert.symbol.toUpperCase() !== symbol) continue;

      const prev = prevCloses[alert.id];
      let triggered = false;

      if (alert.condition === 'above' && close >= alert.price) triggered = true;
      if (alert.condition === 'below' && close <= alert.price) triggered = true;

      if (triggered && prev !== undefined) {
        // Only fire on the crossing event (prev was on the other side)
        const wasBefore = alert.condition === 'above' ? prev < alert.price : prev > alert.price;
        if (!wasBefore) triggered = false;
      }

      prevCloses[alert.id] = close;

      if (triggered) {
        alert.active = false;
        await dbPut(alert);
        fireNotification(alert);
        renderList();
      }
    }
  }

  function fireNotification(alert) {
    const arrow = alert.condition === 'above' ? '▲' : '▼';
    const body  = `${alert.symbol} ${arrow} ${alert.price}`;
    if ('Notification' in window) {
      Notification.requestPermission().then(perm => {
        if (perm === 'granted') {
          new Notification('Price Alert Triggered', { body, icon: '/favicon.svg' });
        }
      });
    }
  }

  // -------------------------------------------------------------------------
  // UI
  // -------------------------------------------------------------------------
  async function renderList() {
    const list = document.getElementById('pa-list');
    if (!list) return;
    const alerts = await dbGetAll();
    const symbol = (window.__loomSymbol || 'BTCUSD').toUpperCase();
    const relevant = alerts.filter(a => a.active && a.symbol.toUpperCase() === symbol);

    if (relevant.length === 0) {
      list.innerHTML = '<div class="pa-empty">No price alerts</div>';
      return;
    }

    list.innerHTML = relevant.map(a => {
      const arrow = a.condition === 'above' ? '▲' : '▼';
      const color = a.condition === 'above' ? '#22c55e' : '#ef4444';
      return `
        <div class="pa-alert-item">
          <div class="pa-alert-info">
            <div class="pa-alert-symbol" style="color:${color}">${arrow} ${a.price.toFixed(2)}</div>
            <div class="pa-alert-desc">${a.symbol}${a.label ? ' · ' + a.label : ''}</div>
          </div>
          <button class="pa-delete-btn" data-id="${a.id}" title="Delete">×</button>
        </div>
      `;
    }).join('');

    list.querySelectorAll('.pa-delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        await dbDelete(btn.dataset.id);
        delete prevCloses[btn.dataset.id];
        renderList();
        redrawAlerts();
      });
    });
  }

  async function addAlert() {
    const symbol    = document.getElementById('pa-symbol')?.value.trim().toUpperCase() || (window.__loomSymbol || 'BTCUSD').toUpperCase();
    const condition = document.getElementById('pa-condition')?.value || 'above';
    const price     = parseFloat(document.getElementById('pa-price')?.value);
    const label     = document.getElementById('pa-label')?.value.trim() || '';

    if (!symbol || isNaN(price) || price <= 0) {
      alert('Please enter a valid symbol and price.');
      return;
    }

    const alert = {
      id: `pa-${Date.now()}-${Math.random().toString(36).slice(2)}`,
      symbol,
      condition,
      price,
      label,
      active: true,
      createdAt: Date.now(),
    };

    await dbPut(alert);
    document.getElementById('pa-price').value = '';
    document.getElementById('pa-label').value = '';
    renderList();
    redrawAlerts();
  }

  // -------------------------------------------------------------------------
  // "Add from chart" — click on Y-axis area sets price
  // -------------------------------------------------------------------------
  let addFromChartMode = false;

  function enableAddFromChart() {
    addFromChartMode = true;
    const btn = document.getElementById('pa-add-from-chart-btn');
    if (btn) btn.classList.add('active');
    document.body.style.cursor = 'crosshair';
  }

  function disableAddFromChart() {
    addFromChartMode = false;
    const btn = document.getElementById('pa-add-from-chart-btn');
    if (btn) btn.classList.remove('active');
    document.body.style.cursor = '';
  }

  function onChartClick(e) {
    if (!addFromChartMode) return;

    let viewportInfo = null;
    try { viewportInfo = window.__loomChart?.getViewportInfo?.(); } catch (_) {}
    if (!viewportInfo) { disableAddFromChart(); return; }

    const canvas = getCanvas();
    if (!canvas) { disableAddFromChart(); return; }
    const rect = canvas.getBoundingClientRect();
    const relY  = e.clientY - rect.top;
    const { priceMin, priceMax } = viewportInfo;
    const price = priceMax - (relY / canvas.height) * (priceMax - priceMin);

    document.getElementById('pa-price').value = price.toFixed(2);
    disableAddFromChart();
  }

  // -------------------------------------------------------------------------
  // Init
  // -------------------------------------------------------------------------
  document.addEventListener('DOMContentLoaded', () => {
    const panel = document.getElementById('price-alerts-panel');
    if (!panel) return;

    // Set default symbol
    const symbolInput = document.getElementById('pa-symbol');
    if (symbolInput) symbolInput.value = window.__loomSymbol || 'BTCUSD';

    document.getElementById('pa-close')?.addEventListener('click', () => panel.classList.add('hidden'));

    window.addEventListener('toggle-price-alerts', () => {
      panel.classList.toggle('hidden');
      if (!panel.classList.contains('hidden')) {
        const sym = document.getElementById('pa-symbol');
        if (sym) sym.value = window.__loomSymbol || 'BTCUSD';
        renderList();
        redrawAlerts();
      }
    });

    document.getElementById('pa-add-btn')?.addEventListener('click', addAlert);

    document.getElementById('pa-add-from-chart-btn')?.addEventListener('click', () => {
      if (addFromChartMode) {
        disableAddFromChart();
      } else {
        enableAddFromChart();
      }
    });

    // Chart click for "add from chart" mode
    document.getElementById('chart-main-container')?.addEventListener('click', onChartClick);
    getCanvas()?.addEventListener('click', onChartClick);

    // Chart events
    window.addEventListener('chart-viewport-changed', redrawAlerts);
    window.addEventListener('chart-candles-updated', async (e) => {
      const candle = e.detail?.candle || e.detail?.lastCandle;
      await checkAlerts(candle);
      redrawAlerts();
    });

    window.addEventListener('resize', () => { resizeCanvas(); redrawAlerts(); });

    renderList();
    resizeCanvas();
  });
})();
</script>
